// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(uuid())
  phone              String   @unique
  isPhoneVerified    Boolean  @default(true)
  onboardingComplete Boolean  @default(false)
  passwordHash       String?
  hashedRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // A user is EITHER a store owner (via `store`, the pre-existing 1:1) OR a
  // staff member of someone else's store (via `staffMembership`) — never
  // both. StoreAccessService resolves whichever applies; nothing else in the
  // codebase should reach for either relation directly.
  staffMembership            StaffMember?
  store                      Store?
  senditConnection           SenditConnection?
  quickLivraisonConnection   QuickLivraisonConnection?
  forceLogConnection         ForceLogConnection?
  ozoneExpressConnection     OzoneExpressConnection?
  ameexConnection            AmeexConnection?
  shopifyOAuthStates         ShopifyOAuthState[]
  youCanOAuthStates          YouCanOAuthState[]
  lightfunnelsOAuthStates    LightfunnelsOAuthState[]
  senditShipments            SenditShipment[]
  quickLivraisonShipments    QuickLivraisonShipment[]
  forceLogShipments          ForceLogShipment[]
  ozoneExpressShipments      OzoneExpressShipment[]
  ameexShipments             AmeexShipment[]
  shippingCourierSuggestions ShippingCourierSuggestion[]
}

model QuickLivraisonConnection {
  id              String    @id @default(uuid())
  encryptedApiKey String
  keyType         String
  connectedAt     DateTime  @default(now())
  lastSyncedAt    DateTime?
  lastSyncError   String?
  updatedAt       DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  shipments QuickLivraisonShipment[]
}

model ForceLogConnection {
  id              String    @id @default(uuid())
  encryptedApiKey String
  connectedAt     DateTime  @default(now())
  lastSyncedAt    DateTime?
  lastSyncError   String?
  updatedAt       DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  shipments ForceLogShipment[]
}

model OzoneExpressConnection {
  id                  String    @id @default(uuid())
  encryptedCustomerId String
  encryptedApiKey     String
  connectedAt         DateTime  @default(now())
  lastSyncedAt        DateTime?
  lastSyncError       String?
  updatedAt           DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  shipments OzoneExpressShipment[]
}

model AmeexConnection {
  id              String    @id @default(uuid())
  encryptedApiId  String
  encryptedApiKey String
  connectedAt     DateTime  @default(now())
  lastSyncedAt    DateTime?
  lastSyncError   String?
  updatedAt       DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  shipments AmeexShipment[]
}

model SenditConnection {
  id                 String   @id @default(uuid())
  encryptedPublicKey String
  encryptedSecretKey String
  accountName        String?
  connectedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  shipments SenditShipment[]
}

enum ShippingShipmentStatus {
  PENDING
  CONFIRMED
  PICKUP_PENDING
  PICKED_UP
  AT_WAREHOUSE
  IN_TRANSIT
  OUT_FOR_DELIVERY
  POSTPONED
  UNREACHABLE
  DELIVERED
  CANCELLED
  REFUSED
  RETURN_PENDING
  RETURN_IN_TRANSIT
  RETURNED_TO_WAREHOUSE
  RETURN_INSPECTION
  RETURNED_TO_STOCK
  RETURNED_TO_SELLER
  UNKNOWN
}

model SenditShipment {
  id                    String                 @id @default(uuid())
  providerCode          String
  providerStatus        String
  providerReturnStatus  String?
  normalizedStatus      ShippingShipmentStatus
  reference             String?
  recipientName         String
  recipientPhone        String
  address               String
  city                  String?
  pickupDistrictId      Int?
  destinationDistrictId Int?
  codAmount             Decimal                @db.Decimal(20, 4)
  fee                   Decimal?               @db.Decimal(20, 4)
  currency              String                 @default("MAD")
  lastActionAt          DateTime?
  providerCreatedAt     DateTime?
  providerUpdatedAt     DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  userId       String
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   SenditConnection?       @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  dispatchId   String?                 @unique
  dispatch     EcommerceOrderDispatch? @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  events       SenditTrackingEvent[]

  @@unique([userId, providerCode])
  @@index([userId, normalizedStatus, updatedAt])
  @@index([connectionId, updatedAt])
  @@index([reference])
}

model SenditTrackingEvent {
  id               String                 @id @default(uuid())
  providerEventKey String
  eventType        String
  providerStatus   String
  normalizedStatus ShippingShipmentStatus
  message          String?
  proofImageUrl    String?
  deliverBy        DateTime?
  unreachableCount Int?
  actor            String?
  eventAt          DateTime
  rawPayload       Json?
  createdAt        DateTime               @default(now())

  shipmentId String
  shipment   SenditShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, providerEventKey])
  @@index([shipmentId, eventAt])
}

model QuickLivraisonShipment {
  id                      String                 @id @default(uuid())
  providerCode            String
  providerStatus          String
  providerSecondaryStatus String?
  situation               String?
  normalizedStatus        ShippingShipmentStatus
  reference               String?
  recipientName           String?
  recipientPhone          String?
  address                 String?
  city                    String?
  destinationDistrictId   Int?
  codAmount               Decimal?               @db.Decimal(20, 4)
  fee                     Decimal?               @db.Decimal(20, 4)
  currency                String                 @default("MAD")
  storeName               String?
  lastActionAt            DateTime?
  providerCreatedAt       DateTime?
  providerUpdatedAt       DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  userId       String
  user         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   QuickLivraisonConnection?     @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  dispatchId   String?                       @unique
  dispatch     EcommerceOrderDispatch?       @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  events       QuickLivraisonTrackingEvent[]

  @@unique([userId, providerCode])
  @@index([userId, normalizedStatus, updatedAt])
  @@index([connectionId, updatedAt])
  @@index([reference])
}

model QuickLivraisonTrackingEvent {
  id                      String                 @id @default(uuid())
  providerEventKey        String
  eventType               String
  providerStatus          String
  providerSecondaryStatus String?
  normalizedStatus        ShippingShipmentStatus
  message                 String?
  actor                   String?
  eventAt                 DateTime
  rawPayload              Json?
  createdAt               DateTime               @default(now())

  shipmentId String
  shipment   QuickLivraisonShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, providerEventKey])
  @@index([shipmentId, eventAt])
}

model ForceLogShipment {
  id                String                 @id @default(uuid())
  providerCode      String
  providerStatus    String
  situation         String?
  normalizedStatus  ShippingShipmentStatus
  reference         String?
  recipientName     String?
  recipientPhone    String?
  address           String?
  city              String?
  codAmount         Decimal?               @db.Decimal(20, 4)
  fee               Decimal?               @db.Decimal(20, 4)
  currency          String                 @default("MAD")
  canOpen           Boolean?
  comment           String?
  productNature     String?
  lastActionAt      DateTime?
  providerCreatedAt DateTime?
  providerUpdatedAt DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  userId       String
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   ForceLogConnection?     @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  dispatchId   String?                 @unique
  dispatch     EcommerceOrderDispatch? @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  events       ForceLogTrackingEvent[]

  @@unique([userId, providerCode])
  @@index([userId, normalizedStatus, updatedAt])
  @@index([connectionId, updatedAt])
  @@index([reference])
}

model ForceLogTrackingEvent {
  id               String                 @id @default(uuid())
  providerEventKey String
  eventType        String
  providerStatus   String
  normalizedStatus ShippingShipmentStatus
  message          String?
  actor            String?
  eventAt          DateTime
  rawPayload       Json?
  createdAt        DateTime               @default(now())

  shipmentId String
  shipment   ForceLogShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, providerEventKey])
  @@index([shipmentId, eventAt])
}

model OzoneExpressShipment {
  id                String                 @id @default(uuid())
  providerCode      String
  providerStatus    String
  normalizedStatus  ShippingShipmentStatus
  reference         String?
  recipientName     String?
  recipientPhone    String?
  address           String?
  city              String?
  cityId            Int?
  codAmount         Decimal?               @db.Decimal(20, 4)
  deliveredPrice    Decimal?               @db.Decimal(20, 4)
  returnedPrice     Decimal?               @db.Decimal(20, 4)
  refusedPrice      Decimal?               @db.Decimal(20, 4)
  fee               Decimal?               @db.Decimal(20, 4)
  currency          String                 @default("MAD")
  note              String?
  nature            String?
  stock             Int?
  canOpen           Int?
  fragile           Int?
  replacement       Int?
  lastActionAt      DateTime?
  providerCreatedAt DateTime?
  providerUpdatedAt DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  userId       String
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   OzoneExpressConnection?     @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  dispatchId   String?                     @unique
  dispatch     EcommerceOrderDispatch?     @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  events       OzoneExpressTrackingEvent[]

  @@unique([userId, providerCode])
  @@index([userId, normalizedStatus, updatedAt])
  @@index([connectionId, updatedAt])
  @@index([reference])
}

model OzoneExpressTrackingEvent {
  id               String                 @id @default(uuid())
  providerEventKey String
  eventType        String
  providerStatus   String
  normalizedStatus ShippingShipmentStatus
  message          String?
  actor            String?
  eventAt          DateTime
  rawPayload       Json?
  createdAt        DateTime               @default(now())

  shipmentId String
  shipment   OzoneExpressShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, providerEventKey])
  @@index([shipmentId, eventAt])
}

model AmeexShipment {
  id                String                 @id @default(uuid())
  providerCode      String
  providerStatus    String
  providerSubStatus String?
  normalizedStatus  ShippingShipmentStatus
  reference         String?
  recipientName     String?
  recipientPhone    String?
  address           String?
  city              String?
  cityId            Int?
  codAmount         Decimal?               @db.Decimal(20, 4)
  fee               Decimal?               @db.Decimal(20, 4)
  currency          String                 @default("MAD")
  note              String?
  nature            String?
  lastActionAt      DateTime?
  providerCreatedAt DateTime?
  providerUpdatedAt DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   AmeexConnection?     @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  events       AmeexTrackingEvent[]

  @@unique([userId, providerCode])
  @@index([providerCode])
  @@index([userId, normalizedStatus, updatedAt])
  @@index([connectionId, updatedAt])
  @@index([reference])
}

model AmeexTrackingEvent {
  id                String                 @id @default(uuid())
  providerEventKey  String
  eventType         String
  providerStatus    String
  providerSubStatus String?
  normalizedStatus  ShippingShipmentStatus
  message           String?
  actor             String?
  eventAt           DateTime
  rawPayload        Json?
  createdAt         DateTime               @default(now())

  shipmentId String
  shipment   AmeexShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, providerEventKey])
  @@index([shipmentId, eventAt])
}

model ShippingCourierSuggestion {
  id          String   @id @default(uuid())
  courierName String
  website     String?
  countryCode String
  notes       String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([countryCode, createdAt])
}

model Store {
  id           String   @id @default(uuid())
  ownerName    String
  // Owner's personal profile photo (Settings > Edit Profile "Add Your
  // Photo") — distinct from `logoUrl`, which is the customer-facing
  // business logo set on the Create/Edit Store screen.
  ownerPhotoUrl String?
  businessName String
  address      String
  city         String
  country      String
  logoUrl      String?
  isActive     Boolean  @default(true)
  baseCurrency String   @default("MAD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String @unique
  // Cascade to match every other 1:1 user relation in this schema — without
  // it, deleting a User who owns a store fails at the FK (was RESTRICT).
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  shopifyConnection       ShopifyConnection?
  shopifyOAuthStates      ShopifyOAuthState[]
  youCanConnection        YouCanConnection?
  youCanOAuthStates       YouCanOAuthState[]
  lightfunnelsConnection  LightfunnelsConnection?
  lightfunnelsOAuthStates LightfunnelsOAuthState[]
  ecommerceConnections    EcommerceConnection[]
  warehouseCategories     ProductCategory[]
  warehouseProducts       WarehouseProduct[]
  warehouseVariants       WarehouseVariant[]
  warehouseLocations      WarehouseLocation[]
  inventoryItems          InventoryItem[]
  inventoryBarcodes       InventoryBarcode[]
  mediaAssets             MediaAsset[]
  packagingMaterials      PackagingMaterial[]
  adsConnections          AdsConnection[]
  roles                   Role[]
  staffMembers            StaffMember[]
  expenseCategories       ExpenseCategory[]
  expenses                Expense[]
}


enum EcommercePlatform {
  SHOPIFY
  YOUCAN
  LIGHTFUNNELS
  MANUAL // WhatsApp/phone/in-person orders entered directly in Zomaal — no external platform to sync from
}

enum EcommerceConnectionStatus {
  ACTIVE
  DISCONNECTED
  REAUTHORIZATION_REQUIRED
}

enum EcommerceOrderStatus {
  OPEN
  CLOSED
  CANCELLED
  UNKNOWN
}

enum EcommercePaymentStatus {
  PENDING
  AUTHORIZED
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
  EXPIRED
  UNKNOWN
}

model EcommerceConnection {
  id                String                    @id @default(uuid())
  platform          EcommercePlatform
  externalAccountId String
  displayName       String?
  status            EcommerceConnectionStatus @default(ACTIVE)
  includeInRevenue  Boolean                   @default(true)
  syncCursor        String?
  syncFrom          DateTime?
  syncStartedAt     DateTime?
  lastSyncedAt      DateTime?
  lastSyncError     String?
  productCount      Int?
  customerCount     Int?
  metricsSyncedAt   DateTime?
  lastMetricsError  String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  shopifyConnection      ShopifyConnection?
  youCanConnection       YouCanConnection?
  lightfunnelsConnection LightfunnelsConnection?
  orders                 EcommerceOrder[]

  @@unique([storeId, platform])
  @@unique([platform, externalAccountId])
  @@index([storeId, status])
  @@index([platform, status])
}

model EcommerceOrder {
  id                String                 @id @default(uuid())
  externalOrderId   String
  orderName         String?
  status            EcommerceOrderStatus
  financialStatus   EcommercePaymentStatus
  fulfillmentStatus String?
  currency          String
  itemCount         Int                    @default(0)
  grossSales        Decimal                @db.Decimal(20, 4)
  discounts         Decimal                @db.Decimal(20, 4)
  refunds           Decimal                @db.Decimal(20, 4)
  netSales          Decimal                @db.Decimal(20, 4)
  shipping          Decimal                @db.Decimal(20, 4)
  tax               Decimal                @db.Decimal(20, 4)
  totalCollected    Decimal                @db.Decimal(20, 4)
  codAmount         Decimal?               @db.Decimal(20, 4)
  codStatus         String?                // PENDING | COLLECTED | FAILED
  shippingCity      String?

  // MANUAL orders only. Shopify/YouCan/Lightfunnels orders intentionally
  // omit customer PII at rest and fetch it live from the platform via the
  // fulfillment-preview adapters at dispatch time — a manual order has no
  // such platform to query later, so it must be captured here at creation.
  manualCustomerName    String?
  manualCustomerPhone   String?
  manualShippingAddress String?
  manualShippingCountry String?
  manualNotes           String?

  providerCreatedAt DateTime
  processedAt       DateTime
  cancelledAt       DateTime?
  providerUpdatedAt DateTime
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  connectionId String
  connection   EcommerceConnection      @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  dispatch     EcommerceOrderDispatch?
  events       EcommerceOrderEvent[]
  lines        EcommerceOrderLine[]
  financialEvents EcommerceOrderFinancialEvent[]
  returnRequests  ReturnRequest[]

  @@unique([connectionId, externalOrderId])
  @@index([connectionId, processedAt])
  @@index([connectionId, providerUpdatedAt])
  @@index([financialStatus, processedAt])
}

model EcommerceOrderEvent {
  id              String   @id @default(uuid())
  orderId         String
  providerEventId String   // always set — generated deterministically when the platform provides no ID
  source          String   // SHOPIFY | YOUCAN | LIGHTFUNNELS | SYSTEM
  type            String   // OrderEventType constant
  title           String
  message         String?
  actor           String?
  location        String?
  metadata        Json?
  occurredAt      DateTime
  synthetic       Boolean  @default(false)
  rawPayload      Json?
  createdAt       DateTime @default(now())

  order EcommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, providerEventId])
  @@index([orderId, occurredAt])
  // A GIN index on `metadata` was tried here first but doesn't help: the
  // lookup this supports (EcommerceService.resolveScannedCode,
  // ReturnRequestService.resolveOrder — resolving a 3rd-party carrier's
  // tracking number to its order) filters via Prisma's `path`+`equals`,
  // which compiles to the `#>` path-extraction operator, not the
  // containment/existence operators (`@>`/`?`/`?|`/`?&`) a default GIN
  // index actually accelerates. The real index is a btree expression index
  // matching that exact `#>` expression, added via a hand-written raw-SQL
  // migration since Prisma's DSL can't express it — see
  // prisma/migrations/*_metadata_number_btree_index/migration.sql.
}

model EcommerceOrderLine {
  id                String   @id @default(uuid())
  externalLineId    String
  externalProductId String?
  externalVariantId String?
  sku               String?
  name              String
  quantity          Int
  unitPrice         Decimal  @db.Decimal(20, 4)
  totalPrice        Decimal  @db.Decimal(20, 4)
  currency          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Recorded by the warehouse scan-and-condition workflow when a shipment
  // comes back. GOOD | DAMAGED | LOST | RETURNED | MISSING. Null until scanned.
  condition           String?
  damageCost          Decimal?  @db.Decimal(20, 4)
  conditionNotes      String?
  conditionRecordedAt DateTime?

  orderId            String
  order              EcommerceOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  warehouseVariantId String?
  warehouseVariant   WarehouseVariant? @relation(fields: [warehouseVariantId], references: [id], onDelete: SetNull)

  returnRequestLines ReturnRequestLine[]

  @@unique([orderId, externalLineId])
  @@index([orderId])
  @@index([warehouseVariantId])
}

// ============================================================================
// Returns module — the warehouse-facing "a parcel came back, verify what's
// inside" workflow (Scan → Return Detected → Manual Verification screens).
// Separate from EcommerceOrderLine.condition above, which this module
// reads/writes through the existing recordProductCondition() write path —
// a ReturnRequest is the wrapper around "this order has a return event in
// progress", condition/damageCost per line stay on EcommerceOrderLine as
// the single source of truth (never duplicated here).
// ============================================================================

enum ReturnRequestStatus {
  NEED_VERIFICATION // detected, not every line has a recorded condition yet
  PROCESSED         // every line in this request has a recorded condition
}

// One "a parcel for this order came back" event. detectedVia/scannedValue
// are audit trail only. DELAYED (shown on the Returns list tabs) is not a
// stored status — it's NEED_VERIFICATION older than a threshold, computed
// at read time in ecommerce-return-request.service.ts, so there is no
// background job needed to flip it.
model ReturnRequest {
  id           String              @id @default(uuid())
  status       ReturnRequestStatus @default(NEED_VERIFICATION)
  reason       String?
  detectedVia  String // SCAN | MANUAL
  scannedValue String?
  verifiedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  orderId String
  order   EcommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  lines ReturnRequestLine[]

  @@index([orderId])
  @@index([status, createdAt])
}

// Which order lines are part of this specific return event. A line can
// appear in more than one ReturnRequest across its lifetime (e.g. a
// mis-scan corrected later), but only one at a time should be
// NEED_VERIFICATION — enforced by a partial unique index on
// ReturnRequest(orderId) WHERE status = 'NEED_VERIFICATION', added via a
// hand-written raw-SQL migration (see
// prisma/migrations/*_add_return_request_open_unique_index/migration.sql)
// since Prisma's schema DSL cannot express a filtered/partial index.
// ReturnRequestService.detect() relies on this to survive two concurrent
// scans of the same order racing past its findFirst check.
model ReturnRequestLine {
  id       String @id @default(uuid())
  quantity Int

  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  orderLineId String
  orderLine   EcommerceOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@unique([returnRequestId, orderLineId])
}

// Immutable append-only ledger. Each row is one financial event triggered by
// a carrier status reaching DELIVERED/CANCELLED-like, or by a DAMAGED
// condition recorded on a return. Current totals for an order = sum of its
// events, never a mutated snapshot — corrections add a new event rather than
// rewriting history. revenue/productCost/shippingCost/damageCost are positive
// magnitudes describing what this specific event represents; netProfitImpact
// is the signed contribution to profit and is what always sums correctly
// across events regardless of type.
model EcommerceOrderFinancialEvent {
  id              String   @id @default(uuid())
  orderId         String
  type            String   // REVENUE_RECOGNIZED | REVENUE_REVERSED | DAMAGE_LOSS
  revenue         Decimal  @db.Decimal(20, 4)
  productCost     Decimal  @db.Decimal(20, 4)
  shippingCost    Decimal  @db.Decimal(20, 4)
  damageCost      Decimal  @db.Decimal(20, 4)
  netProfitImpact Decimal  @db.Decimal(20, 4)
  currency        String
  reason          String
  idempotencyKey  String
  createdAt       DateTime @default(now())

  order EcommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, idempotencyKey])
  @@index([orderId, createdAt])
}

model EcommerceOrderDispatch {
  id               String   @id @default(uuid())
  provider         String // e.g., 'SENDIT', 'QUICKLIVRAISON', 'FORCELOG', 'OZONEEXPRESS'
  merchantTracking String // stable merchant reference
  providerTracking String? // returned by courier
  status           String   @default("PENDING") // PENDING, DISPATCHED, FAILED
  errorMessage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderId                String                  @unique
  order                  EcommerceOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senditShipment         SenditShipment?
  quickLivraisonShipment QuickLivraisonShipment?
  forceLogShipment       ForceLogShipment?
  ozoneExpressShipment   OzoneExpressShipment?

  @@index([provider, status])
  @@index([providerTracking])
}

enum ShopifyConnectionStatus {
  ACTIVE
  DISCONNECTED
  REAUTHORIZATION_REQUIRED
}

model ShopifyConnection {
  id                    String                  @id @default(uuid())
  shopDomain            String                  @unique
  status                ShopifyConnectionStatus @default(ACTIVE)
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  grantedScopes         String
  installedAt           DateTime                @default(now())
