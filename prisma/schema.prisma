// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(uuid())
  phone              String   @unique
  isPhoneVerified    Boolean  @default(true)
  onboardingComplete Boolean  @default(false)
  passwordHash       String?
  hashedRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  store                    Store?
  senditConnection         SenditConnection?
  quickLivraisonConnection QuickLivraisonConnection?
  forceLogConnection       ForceLogConnection?
  ozoneExpressConnection   OzoneExpressConnection?
  shopifyOAuthStates       ShopifyOAuthState[]
  youCanOAuthStates        YouCanOAuthState[]
  lightfunnelsOAuthStates  LightfunnelsOAuthState[]
}

model QuickLivraisonConnection {
  id              String   @id @default(uuid())
  encryptedApiKey String
  keyType         String
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ForceLogConnection {
  id              String   @id @default(uuid())
  encryptedApiKey String
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OzoneExpressConnection {
  id                  String   @id @default(uuid())
  encryptedCustomerId String
  encryptedApiKey     String
  connectedAt         DateTime @default(now())
  updatedAt           DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SenditConnection {
  id                 String   @id @default(uuid())
  encryptedPublicKey String
  encryptedSecretKey String
  accountName        String?
  connectedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Store {
  id           String   @id @default(uuid())
  ownerName    String
  businessName String
  address      String
  city         String
  country      String
  logoUrl      String?
  isActive     Boolean  @default(true)
  baseCurrency String   @default("MAD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  shopifyConnection       ShopifyConnection?
  shopifyOAuthStates      ShopifyOAuthState[]
  youCanConnection        YouCanConnection?
  youCanOAuthStates       YouCanOAuthState[]
  lightfunnelsConnection  LightfunnelsConnection?
  lightfunnelsOAuthStates LightfunnelsOAuthState[]
  ecommerceConnections    EcommerceConnection[]
  warehouseCategories     ProductCategory[]
  warehouseProducts       WarehouseProduct[]
  warehouseVariants       WarehouseVariant[]
  warehouseLocations      WarehouseLocation[]
  inventoryItems          InventoryItem[]
  inventoryBarcodes       InventoryBarcode[]
  mediaAssets             MediaAsset[]
  packagingMaterials      PackagingMaterial[]
}

enum EcommercePlatform {
  SHOPIFY
  YOUCAN
  LIGHTFUNNELS
}

enum EcommerceConnectionStatus {
  ACTIVE
  DISCONNECTED
  REAUTHORIZATION_REQUIRED
}

enum EcommerceOrderStatus {
  OPEN
  CLOSED
  CANCELLED
  UNKNOWN
}

enum EcommercePaymentStatus {
  PENDING
  AUTHORIZED
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
  EXPIRED
  UNKNOWN
}

model EcommerceConnection {
  id                String                    @id @default(uuid())
  platform          EcommercePlatform
  externalAccountId String
  displayName       String?
  status            EcommerceConnectionStatus @default(ACTIVE)
  includeInRevenue  Boolean                   @default(true)
  syncCursor        String?
  syncFrom          DateTime?
  syncStartedAt     DateTime?
  lastSyncedAt      DateTime?
  lastSyncError     String?
  productCount      Int?
  customerCount     Int?
  metricsSyncedAt   DateTime?
  lastMetricsError  String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  shopifyConnection      ShopifyConnection?
  youCanConnection       YouCanConnection?
  lightfunnelsConnection LightfunnelsConnection?
  orders                 EcommerceOrder[]

  @@unique([storeId, platform])
  @@unique([platform, externalAccountId])
  @@index([storeId, status])
  @@index([platform, status])
}

model EcommerceOrder {
  id                String                 @id @default(uuid())
  externalOrderId   String
  orderName         String?
  status            EcommerceOrderStatus
  financialStatus   EcommercePaymentStatus
  fulfillmentStatus String?
  currency          String
  itemCount         Int                    @default(0)
  grossSales        Decimal                @db.Decimal(20, 4)
  discounts         Decimal                @db.Decimal(20, 4)
  refunds           Decimal                @db.Decimal(20, 4)
  netSales          Decimal                @db.Decimal(20, 4)
  shipping          Decimal                @db.Decimal(20, 4)
  tax               Decimal                @db.Decimal(20, 4)
  totalCollected    Decimal                @db.Decimal(20, 4)
  providerCreatedAt DateTime
  processedAt       DateTime
  cancelledAt       DateTime?
  providerUpdatedAt DateTime
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  connectionId String
  connection   EcommerceConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  dispatch     EcommerceOrderDispatch?

  @@unique([connectionId, externalOrderId])
  @@index([connectionId, processedAt])
  @@index([connectionId, providerUpdatedAt])
  @@index([financialStatus, processedAt])
}

model EcommerceOrderDispatch {
  id               String   @id @default(uuid())
  provider         String // e.g., 'SENDIT', 'QUICKLIVRAISON', 'FORCELOG', 'OZONEEXPRESS'
  merchantTracking String // stable merchant reference
  providerTracking String? // returned by courier
  status           String   @default("PENDING") // PENDING, DISPATCHED, FAILED
  errorMessage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderId String         @unique
  order   EcommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([provider, status])
}

enum ShopifyConnectionStatus {
  ACTIVE
  DISCONNECTED
  REAUTHORIZATION_REQUIRED
}

model ShopifyConnection {
  id                    String                  @id @default(uuid())
  shopDomain            String                  @unique
  status                ShopifyConnectionStatus @default(ACTIVE)
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  grantedScopes         String
  installedAt           DateTime                @default(now())
  disconnectedAt        DateTime?
  lastVerifiedAt        DateTime?
  lastWebhookAt         DateTime?
  lastWebhookError      String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  ecommerceConnectionId String?              @unique
  ecommerceConnection   EcommerceConnection? @relation(fields: [ecommerceConnectionId], references: [id], onDelete: Cascade)

  @@index([status])
}

model ShopifyOAuthState {
  id         String   @id @default(uuid())
  stateHash  String   @unique
  shopDomain String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, storeId])
}

model ShopifyWebhookReceipt {
  webhookId   String   @id
  topic       String
  shopDomain  String
  processedAt DateTime @default(now())

  @@index([shopDomain])
  @@index([processedAt])
}

enum YouCanConnectionStatus {
  ACTIVE
  DISCONNECTED
  REAUTHORIZATION_REQUIRED
}

model YouCanConnection {
  id                    String                 @id @default(uuid())
  externalStoreId       String                 @unique
  storeDomain           String?
  displayName           String?
  currencyCode          String?
  status                YouCanConnectionStatus @default(ACTIVE)
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  accessTokenExpiresAt  DateTime?
  tokenType             String                 @default("Bearer")
  grantedScopes         String
  installedAt           DateTime               @default(now())
  disconnectedAt        DateTime?
  lastVerifiedAt        DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  ecommerceConnectionId String              @unique
  ecommerceConnection   EcommerceConnection @relation(fields: [ecommerceConnectionId], references: [id], onDelete: Cascade)

  @@index([status])
}

model YouCanOAuthState {
  id              String   @id @default(uuid())
  stateHash       String   @unique
  requestedScopes String
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, storeId])
}

enum LightfunnelsConnectionStatus {
  ACTIVE
  DISCONNECTED
  REAUTHORIZATION_REQUIRED
}

model LightfunnelsConnection {
  id                   String                       @id @default(uuid())
  externalAccountId    String                       @unique
  displayName          String?
  storeDomain          String?
  status               LightfunnelsConnectionStatus @default(ACTIVE)
  encryptedAccessToken String?
  grantedScopes        String
  installedAt          DateTime                     @default(now())
  disconnectedAt       DateTime?
  lastVerifiedAt       DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  ecommerceConnectionId String              @unique
  ecommerceConnection   EcommerceConnection @relation(fields: [ecommerceConnectionId], references: [id], onDelete: Cascade)

  @@index([status])
}

model LightfunnelsOAuthState {
  id              String   @id @default(uuid())
  stateHash       String   @unique
  requestedScopes String
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, storeId])
}

enum WarehouseProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InventoryItemKind {
  PRODUCT_VARIANT
  PACKAGING_MATERIAL
}

enum InventoryBarcodeType {
  INTERNAL_CODE_128
  GTIN
  EAN_13
  UPC_A
  OTHER
}

enum InventoryBucket {
  ON_HAND
  RESERVED
  DAMAGED
  INCOMING
}

enum InventoryMovementType {
  OPENING_BALANCE
  MANUAL_ADJUSTMENT
  ORDER_RESERVED
  ORDER_RELEASED
  ORDER_SHIPPED
  RETURN_GOOD
  RETURN_DAMAGED
  PACKAGING_RECEIVED
  PACKAGING_CONSUMED
}

enum MediaAssetStatus {
  TEMPORARY
  ATTACHED
}

enum MediaAssetPurpose {
  PRODUCT_MAIN
  PRODUCT_GALLERY
  VARIANT
}

model ProductCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String
  description String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  parentId String?
  parent   ProductCategory?   @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ProductCategory[]  @relation("ProductCategoryTree")
  products WarehouseProduct[]

  @@unique([storeId, slug])
  @@index([storeId, isActive, position])
  @@index([parentId])
}

model WarehouseProduct {
  id                     String                 @id @default(uuid())
  name                   String
  description            String?
  status                 WarehouseProductStatus @default(DRAFT)
  idempotencyKey         String?
  idempotencyFingerprint String?
  version                Int                    @default(1)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  archivedAt             DateTime?

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  options               ProductOption[]
  variants              WarehouseVariant[]
  media                 MediaAsset[]
  gift                  ProductGift?                  @relation("ProductGiftOwner")
  packagingRequirements ProductPackagingRequirement[]

  @@unique([storeId, idempotencyKey])
  @@index([storeId, status, createdAt])
  @@index([categoryId])
}

model ProductOption {
  id        String               @id @default(uuid())
  name      String
  position  Int
  productId String
  product   WarehouseProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductOptionValue[]

  @@unique([productId, position])
  @@unique([productId, name])
}

model ProductOptionValue {
  id       String                        @id @default(uuid())
  value    String
  position Int
  optionId String
  option   ProductOption                 @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants WarehouseVariantOptionValue[]

  @@unique([optionId, value])
  @@unique([optionId, position])
}

model WarehouseVariant {
  id                String   @id @default(uuid())
  title             String
  sku               String?
  price             Decimal  @db.Decimal(20, 4)
  costPrice         Decimal  @db.Decimal(20, 4)
  lowStockThreshold Int      @default(5)
  isDefault         Boolean  @default(false)
  position          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productId String
  product   WarehouseProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  optionValues       WarehouseVariantOptionValue[]
  inventoryItem      InventoryItem?
  media              MediaAsset[]
  usedAsGift         ProductGift[]                 @relation("GiftVariant")
  packagingOverrides ProductPackagingRequirement[]

  @@unique([storeId, sku])
  @@index([productId, position])
}

model WarehouseVariantOptionValue {
  variantId String
  variant   WarehouseVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  valueId   String
  value     ProductOptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([variantId, valueId])
  @@index([valueId])
}

model InventoryItem {
  id        String            @id @default(uuid())
  kind      InventoryItemKind
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  variantId String?           @unique
  variant   WarehouseVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  packagingMaterialId String?            @unique
  packagingMaterial   PackagingMaterial? @relation(fields: [packagingMaterialId], references: [id], onDelete: Cascade)

  barcodes  InventoryBarcode[]
  balances  InventoryBalance[]
  movements InventoryMovement[]

  @@index([storeId, kind])
}

model InventoryBarcode {
  id        String               @id @default(uuid())
  value     String
  type      InventoryBarcodeType
  isPrimary Boolean              @default(false)
  source    String               @default("ZOMAAL")
  createdAt DateTime             @default(now())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([storeId, value])
  @@index([inventoryItemId, isPrimary])
}

model WarehouseLocation {
  id        String   @id @default(uuid())
  name      String
  code      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  balances  InventoryBalance[]
  movements InventoryMovement[]

  @@unique([storeId, code])
  @@index([storeId, isDefault])
}

model InventoryBalance {
  id       String @id @default(uuid())
  onHand   Int    @default(0)
  reserved Int    @default(0)
  damaged  Int    @default(0)
  incoming Int    @default(0)
  version  Int    @default(1)

  inventoryItemId String
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  locationId      String
  location        WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([inventoryItemId, locationId])
  @@index([locationId])
}

model InventoryMovement {
  id                String                @id @default(uuid())
  type              InventoryMovementType
  bucket            InventoryBucket
  quantityDelta     Int
  resultingQuantity Int
  reason            String?
  referenceType     String?
  referenceId       String?
  idempotencyKey    String?
  createdAt         DateTime              @default(now())

  inventoryItemId String
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  locationId      String
  location        WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([inventoryItemId, idempotencyKey])
  @@index([inventoryItemId, createdAt])
  @@index([locationId, createdAt])
  @@index([referenceType, referenceId])
}

model MediaAsset {
  id           String            @id @default(uuid())
  objectName   String            @unique
  originalName String
  contentType  String
  sizeBytes    Int
  checksum     String
  status       MediaAssetStatus  @default(TEMPORARY)
  purpose      MediaAssetPurpose
  position     Int               @default(0)
  expiresAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  productId String?
  product   WarehouseProduct? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   WarehouseVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([storeId, status, expiresAt])
  @@index([productId, position])
  @@index([variantId, position])
}

model ProductGift {
  id       String @id @default(uuid())
  quantity Int    @default(1)

  productId String           @unique
  product   WarehouseProduct @relation("ProductGiftOwner", fields: [productId], references: [id], onDelete: Cascade)

  giftVariantId String
  giftVariant   WarehouseVariant @relation("GiftVariant", fields: [giftVariantId], references: [id], onDelete: Restrict)

  @@index([giftVariantId])
}

model PackagingMaterial {
  id                  String   @id @default(uuid())
  zomaalShopVariantId String
  name                String
  sku                 String?
  imageObjectName     String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  inventoryItem InventoryItem?
  requirements  ProductPackagingRequirement[]

  @@unique([storeId, zomaalShopVariantId])
  @@index([storeId, isActive])
}

model ProductPackagingRequirement {
  id              String @id @default(uuid())
  quantityPerUnit Int

  productId String
  product   WarehouseProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   WarehouseVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  packagingMaterialId String
  packagingMaterial   PackagingMaterial @relation(fields: [packagingMaterialId], references: [id], onDelete: Restrict)

  @@unique([productId, variantId, packagingMaterialId])
  @@index([packagingMaterialId])
}
