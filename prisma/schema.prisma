// ============================================================================
// Ads Module — platform-agnostic. TikTok is the first implementation
// (src/ads/tiktok/); Meta/Google/Snapchat plug into these same four models
// later by adding their own auth/api/sync services that write into them,
// same pattern as Shopify/YouCan/Lightfunnels sharing EcommerceConnection.
//
// This is unrelated to the legacy AdSpendEntry manual ledger above — that
// table stays read-only/always-empty. Once this module is live, the
// Expenses screen's "Advertising Cost" tile should be repointed to read
// from AdsMetricSnapshot instead (tracked separately, not done in this pass).
// ============================================================================

enum AdsPlatform {
  TIKTOK
  META
  GOOGLE
  SNAPCHAT
}

enum AdsConnectionStatus {
  ACTIVE
  DISCONNECTED
  REAUTHORIZATION_REQUIRED
}

// One authorized ad account (TikTok "advertiser", Meta "ad account", etc.)
// linked to a Zomaal store. A store can connect multiple accounts on the
// same platform (e.g. two TikTok advertiser IDs) — externalAdvertiserId
// disambiguates them.
model AdsConnection {
  id                    String               @id @default(uuid())
  platform              AdsPlatform
  status                AdsConnectionStatus  @default(ACTIVE)
  externalAdvertiserId  String
  displayName           String?
  currency              String?
  timezone              String?
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  accessTokenExpiresAt  DateTime?
  grantedScopes         String?
  installedAt           DateTime             @default(now())
  disconnectedAt        DateTime?
  lastVerifiedAt        DateTime?
  lastSyncedAt          DateTime?
  lastSyncError         String?
  syncStartedAt         DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  campaigns AdsCampaign[]

  @@unique([storeId, platform, externalAdvertiserId])
  @@index([storeId, platform])
  @@index([platform, status])
}

// Single-use OAuth CSRF state, mirrors ShopifyOAuthState/YouCanOAuthState.
// Not tied to Store via a Prisma relation (same as the others) — storeId is
// looked up manually so a leftover expired row can never block a new store.
model AdsOAuthState {
  id        String      @id @default(uuid())
  stateHash String      @unique
  platform  AdsPlatform
  expiresAt DateTime
  userId    String
  storeId   String
  createdAt DateTime    @default(now())

  @@index([storeId, platform])
}

// One ad campaign as known to the platform. Synced (read-only mirror) on
// every campaign-list refresh; tracked = merchant selected it on the
// "Select Campaigns" screen — only tracked campaigns get metric snapshots.
model AdsCampaign {
  id                 String    @id @default(uuid())
  externalCampaignId String
  name               String
  status             String // platform's raw status string, e.g. ENABLE/DISABLE, ACTIVE/PAUSED
  objective          String?
  budget             Decimal?  @db.Decimal(20, 4)
  currency           String?
  startDate          DateTime?
  endDate            DateTime?
  tracked            Boolean   @default(false)
  rawPayload         Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  connectionId String
  connection   AdsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  metrics AdsMetricSnapshot[]

  @@unique([connectionId, externalCampaignId])
  @@index([connectionId, tracked])
}

// One day of performance for one tracked campaign. Upserted idempotently on
// (campaignId, date) — a re-sync of the same day overwrites rather than
// duplicates, since platform reporting numbers can be revised for a few
// days after the fact (attribution windows).
model AdsMetricSnapshot {
  id             String   @id @default(uuid())
  date           DateTime @db.Date
  spend          Decimal  @db.Decimal(20, 4)
  clicks         Int      @default(0)
  impressions    Int      @default(0)
  results        Int      @default(0)
  reach          Int?
  frequency      Decimal? @db.Decimal(10, 4)
  cpm            Decimal? @db.Decimal(20, 4)
  ctr            Decimal? @db.Decimal(10, 4)
  costPerResult  Decimal? @db.Decimal(20, 4)
  conversionRate Decimal? @db.Decimal(10, 4)
  currency       String
  rawPayload     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaignId String
  campaign   AdsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([campaignId, date])
}

// ============================================================================
// Staff, roles and access control
//
// Until now a store had exactly one user (Store.userId, unique). A store can
// now also have staff: separate User accounts that log in with their own
// phone + password (POST /auth/login already supports this) and reach the
// store through StaffMember instead of through ownership.
//
// A person belongs to at most one store (StaffMember.userId is unique).
// Managing staff and roles is owner-only and is NOT expressible as a
// permission — see src/access/permissions.ts.
// ============================================================================

// A named permission preset, e.g. "Operations Manager". Permissions are the
// string keys from src/access/permissions.ts ("orders.view", "returns.scan",
// ...) rather than boolean columns, so adding a sub-action later needs no
// migration. Roles are per-store: one store's "Manager" is unrelated to
// another's.
model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  permissions String[]
  // Seeded defaults a store starts with. Editable, but not deletable, so a
  // store can never end up with zero roles to assign.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  staffMembers StaffMember[]

  @@unique([storeId, name])
  @@index([storeId])
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

// The staff-specific profile hanging off a User. Deactivating sets status
// INACTIVE (the "Deactive" button) — staff are never hard-deleted, so their
// salary history and the audit trail on expenses they created stay intact.
model StaffMember {
  id       String      @id @default(uuid())
  // The User model only carries `phone` (the login identifier) — no name.
  // Every Staff list/details screen needs a display name, so it lives here.
  name     String
  jobTitle String? // "Operations Manager" — a label, not a permission source
  photoUrl String?
  status   StaffStatus @default(ACTIVE)
  // Staff Details shows these as two separate rows — "Last Active 2 hours
  // ago" in the header and "Last Login: Apr 26, 2026, 2:30 PM" under
  // Activity — so they are two fields: lastActiveAt is touched by any
  // authenticated request, lastLoginAt only by a successful login.
  lastActiveAt DateTime?
  lastLoginAt  DateTime?
  joinedAt     DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Unique: a person belongs to at most one store.
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Nullable so a staff member can exist before a role is assigned, and so
  // deleting a role doesn't cascade-delete people.
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Per-person exception to the role's preset. EMPTY means "inherit the role
  // exactly", which is the normal case — that's the whole point of roles
  // being real: edit the role once and everyone on it changes. Non-empty
  // replaces the role's list entirely for this one person, which is what the
  // per-staff toggles on Add/Edit Staff write to when an owner deviates.
  // Effective permissions are resolved in one place (StoreAccessService), so
  // nothing else needs to know this rule.
  permissionOverrides String[]

  salaryProfile  StaffSalaryProfile?
  salaryPayments StaffSalaryPayment[]
  salaryExpenses Expense[]            @relation("SalaryExpensesFor")

  @@index([storeId, status])
}

enum SalaryFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum SalaryPaymentMethod {
  BANK_TRANSFER
  CASH
}

// AUTOMATIC: paying a salary also writes the matching Expense row.
// MANUAL: the owner records that expense themselves later.
enum SalaryExpenseHandling {
  AUTOMATIC
  MANUAL
}

// The recurring salary agreement — the "Manage Salary Info" screen. One per
// staff member; individual payments live in StaffSalaryPayment.
model StaffSalaryProfile {
  id              String                @id @default(uuid())
  baseSalary      Decimal               @db.Decimal(20, 4)
  frequency       SalaryFrequency
  paymentMethod   SalaryPaymentMethod
  expenseHandling SalaryExpenseHandling @default(AUTOMATIC)
  startDate       DateTime
  // Derived and stored so the staff list can show "Next: 16-05-2026" and
  // filter overdue without recomputing a schedule per row.
  nextPaymentDate DateTime?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  staffMemberId String      @unique
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
}

enum SalaryPaymentStatus {
  PENDING
  PAID
}

// One salary payment. OVERDUE is deliberately NOT a stored status — it is
// PENDING with paymentDate in the past, derived at read time, so nothing has
// to run on a schedule to keep it truthful (same approach as ReturnRequest's
// DELAYED).
model StaffSalaryPayment {
  id            String              @id @default(uuid())
  amount        Decimal             @db.Decimal(20, 4)
  paymentDate   DateTime
  paidAt        DateTime?
  paymentMethod SalaryPaymentMethod
  status        SalaryPaymentStatus @default(PENDING)
  notes         String?
  receiptUrl    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  // Set when expenseHandling was AUTOMATIC — links the payment to the expense
  // it generated, so the Expenses screen never double-counts it and deleting
  // one can clean up the other.
  expenseId String?  @unique
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  receiptMedia MediaAsset?

  @@index([staffMemberId, paymentDate])
  @@index([status, paymentDate])
}

// ============================================================================
// Expenses
//
// The Expenses screen is a hybrid: each category unions rows entered by hand
// here with figures already owned by other modules (courier fees, real ad
// spend, warehouse purchases, salary payments). Those are read from their
// source at query time and never copied into Expense, so the two can't drift
// apart or double-count.
// ============================================================================

// The Expenses screen has TWO levels of category and they are not the same
// list:
//
//   • The summary screen groups everything into 5 fixed buckets —
//     Shipping Costs / Ad spend / Staff Salary / Purchase Costs /
//     Other Expenses. That is ExpenseGroup below.
//   • "Add Expense" offers granular categories — Rent, Bills, Supplies,
//     Marketing, Maintenance, Employee salary, plus anything created via
//     "+ Create Category". Those are ExpenseCategory rows.
//
// Most granular categories roll up into OTHER (the Other Expenses detail
// screen shows "Equipment Repair" tagged "Maintenance"), which is why every
// category carries the bucket it belongs to.
enum ExpenseGroup {
  SHIPPING
  ADS
  SALARY
  PURCHASES
  OTHER
}

// Seeded system categories (Rent, Bills, Supplies, Marketing, Maintenance,
// Employee salary) plus anything the merchant adds via "+ Create Category".
model ExpenseCategory {
  id   String       @id @default(uuid())
  name String
  // Which of the 5 summary buckets this category totals into. Custom
  // categories default to OTHER.
  group     ExpenseGroup @default(OTHER)
  icon      String?
  color     String?
  isSystem  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  expenses Expense[]

  @@unique([storeId, name])
  @@index([storeId])
}

enum ExpensePaymentMethod {
  CASH
  BANK
}

// A manually recorded expense — the "Add Expense" screen.
model Expense {
  id            String               @id @default(uuid())
  title         String
  amount        Decimal              @db.Decimal(20, 4)
  paymentMethod ExpensePaymentMethod
  spentAt       DateTime
  notes         String?
  receiptUrl    String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Required when the category's group is SALARY, ignored otherwise: which
  // staff member this salary expense is for. Set automatically when a salary
  // payment on AUTOMATIC generates its expense, and chosen by the owner when
  // they record a MANUAL one by hand. Having it here is what makes the
  // "don't let a manual salary expense double-count an automatic one" check
  // possible at all.
  staffMemberId String?
  staffFor      StaffMember? @relation("SalaryExpensesFor", fields: [staffMemberId], references: [id], onDelete: SetNull)

  // Audit: which user recorded it. Nullable and SetNull so removing a user
  // never destroys the expense record itself.
  createdByUserId String?

  salaryPayment StaffSalaryPayment?
  receiptMedia  MediaAsset?

  @@index([storeId, spentAt])
  @@index([storeId, categoryId])
}
