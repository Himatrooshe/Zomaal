{
  "date": "2026-10-20",
  "deployedCommit": "75c8524",
  "environment": "live production API with a dedicated labelled QA store",
  "api": "https://zomaal-backend-563898960389.us-central1.run.app",
  "recordedChecks": {
    "expandedApiSuite": 377,
    "courierSuite": 35,
    "note": "Includes setup, retries, cleanup assertions and group failure markers; these are not counts of distinct business scenarios. Raw discrepancies include expected provider phone rejection and the missing-secret configuration case."
  },
  "findings": [
    {
      "id": "LIVE-01",
      "classification": "VALIDATION_BUG",
      "summary": "Returns accepts limit=101 despite the documented maximum of 100",
      "expectedHttp": 400,
      "actualHttp": 200,
      "source": "ReturnListQueryDto.limit lacks @Max(100)"
    },
    {
      "id": "LIVE-02",
      "classification": "IDEMPOTENCY_CONTRACT_GAP",
      "summary": "Changed manual-order payload with the same retry key silently returns the previous order",
      "observation": {
        "http": 201,
        "sameOrder": true,
        "returnedShipping": "15.00",
        "expectedOriginalShipping": 15,
        "submittedShipping": 16
      },
      "impact": "No duplicate or overwritten order observed; caller is not told that its changed data was ignored."
    },
    {
      "id": "LIVE-03",
      "classification": "VALIDATION_BUG",
      "summary": "damageCost=10000000000000000 reaches the database and returns 500",
      "expectedHttp": 400,
      "actualHttp": 500,
      "atomicRollbackVerified": true,
      "source": "Amount exceeds Decimal(20,4); precision validation does not bound magnitude."
    },
    {
      "id": "LIVE-04",
      "classification": "STAFF_ACCESS_BUG",
      "summary": "Staff with orders.view receives 404 for owned-store order financials",
      "expectedHttp": 200,
      "actualHttp": 404,
      "source": "Financial summary lookup filters connection.store.userId by staff user ID instead of resolving staff store access."
    },
    {
      "id": "LIVE-05",
      "classification": "STORE_DELETION_BUG",
      "summary": "Deleting a temporary store containing inventory movements returns 500",
      "actualHttp": 500,
      "constraint": "InventoryMovement_inventoryItemId_fkey",
      "impact": "Temporary store retained with archived products and zero stock; original active store restored."
    },
    {
      "id": "LIVE-06",
      "classification": "COURIER_LIFECYCLE_GAP",
      "summary": "ForceLog confirms parcel deletion but Zomaal still resolves its status as PENDING",
      "providerDeletionConfirmed": true,
      "actualStatus": "PENDING",
      "source": "deleteForceLogParcel forwards provider deletion without reconciling local shipment/dispatch state."
    },
    {
      "id": "CONFIG-01",
      "classification": "DEPLOYMENT_CONFIGURATION",
      "summary": "QuickLivraison webhook secret is not configured",
      "actualHttp": 503,
      "impact": "Valid signed callback acceptance cannot be verified until the shared secret is configured on both sides."
    }
  ],
