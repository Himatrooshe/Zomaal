<!doctype html>
<html lang="en">
<head>
{{> head title="Shop Products"}}
</head>
<body class="h-dvh flex text-zinc-900 bg-white">
{{> sidebar active="products"}}

<div class="flex-1 min-w-0 flex flex-col">
  {{> topbar}}

  <main class="flex-1 min-w-0 overflow-y-auto p-4 sm:p-6 lg:p-8 flex flex-col gap-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h1 class="text-xl font-bold tracking-tight">Shop Products</h1>
        <p class="mt-1 text-[13px] text-zinc-500">Catalog of items merchants can purchase from the Zomaal Shop.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button id="export-products-btn" class="border border-zinc-200 rounded-lg px-3.5 py-2 text-[13px] font-semibold hover:bg-zinc-50">Export CSV</button>
        <label class="border border-zinc-200 rounded-lg px-3.5 py-2 text-[13px] font-semibold hover:bg-zinc-50 cursor-pointer">
          Import CSV
          <input id="import-products-input" type="file" accept=".csv,text/csv" class="hidden" />
        </label>
        <button id="add-product-btn" class="flex items-center gap-2 bg-zinc-900 text-white rounded-lg px-4 py-2 text-[13px] font-semibold hover:bg-zinc-800">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add Product
        </button>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2.5">
      <input id="product-search" placeholder="Search products…"
        class="w-full sm:w-[280px] border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
      <select id="product-category-filter" class="w-full sm:w-auto border border-zinc-200 rounded-lg px-3 py-2 text-[13px] text-zinc-700">
        <option value="">All Categories</option>
      </select>
      <div class="flex items-center bg-zinc-100 border border-zinc-200 rounded-lg p-0.5 text-[12.5px] font-semibold">
        <button data-status="" class="product-status-filter-btn px-3 py-1.5 rounded-md bg-white shadow-sm text-zinc-900">All</button>
        <button data-status="ACTIVE" class="product-status-filter-btn px-3 py-1.5 rounded-md text-zinc-500">Active</button>
        <button data-status="DRAFT" class="product-status-filter-btn px-3 py-1.5 rounded-md text-zinc-500">Draft</button>
      </div>
    </div>

    <p id="products-error" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-2.5 text-[12.5px] text-red-600 whitespace-pre-line"></p>
    <p id="products-notice" class="hidden rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-2.5 text-[12.5px] text-emerald-700"></p>

    <div class="border border-zinc-200 rounded-xl overflow-x-auto">
      <table class="stack w-full text-sm min-w-[640px]">
        <thead>
          <tr class="bg-zinc-50 border-b border-zinc-200 text-left text-[11px] font-semibold text-zinc-400 uppercase tracking-wide">
            <th class="px-4 py-3">Product</th>
            <th class="px-4 py-3">Category</th>
            <th class="px-4 py-3">Price</th>
            <th class="px-4 py-3">Stock</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="products-tbody">
          <tr><td colspan="6" class="px-4 py-6 text-center text-zinc-400 text-sm">Loading&hellip;</td></tr>
        </tbody>
      </table>
    </div>
  </main>
</div>

<dialog id="product-dialog" class="rounded-xl p-0 w-[calc(100%-2rem)] max-w-[640px] backdrop:bg-zinc-900/40">
  <form id="product-form" class="flex flex-col max-h-[85vh]">
    <div class="px-5 py-4 border-b border-zinc-200 shrink-0">
      <div id="product-dialog-title" class="text-sm font-bold">Add Product</div>
    </div>
    <div class="px-5 py-[18px] flex flex-col gap-3.5 overflow-y-auto">
      <input type="hidden" name="id" />
      <div class="flex flex-col gap-1.5">
        <div class="flex items-baseline justify-between gap-2">
          <label class="text-xs font-semibold">Images</label>
          <span id="product-images-count" class="text-[11px] text-zinc-400"></span>
        </div>
        <!-- Existing (saved) images and newly picked (pending) images share one
             grid; the first tile is the cover. Rendered by app.js. -->
        <div id="product-images-grid" class="grid grid-cols-3 sm:grid-cols-4 gap-2"></div>
        <label id="product-images-drop" class="flex flex-col items-center justify-center gap-1 rounded-lg border border-dashed border-zinc-300 bg-zinc-50 px-3 py-4 text-center cursor-pointer hover:border-zinc-400 hover:bg-zinc-100/60">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#71717a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
          <span class="text-[12.5px] font-semibold text-zinc-700">Add images</span>
          <span class="text-[11px] text-zinc-400">Click or drop · JPEG, PNG, WebP · max 5 MB each · up to 8</span>
          <input id="product-images-input" type="file" accept="image/jpeg,image/png,image/webp" multiple class="sr-only" />
        </label>
        <p id="product-images-hint" class="text-[11px] text-zinc-400">New images upload when you save. The first image is the cover.</p>
        <p id="product-images-error" class="hidden text-[12px] font-medium text-red-600 whitespace-pre-line"></p>
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Product Name</label>
        <input name="name" required maxlength="150"
          class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold">Category</label>
          <select name="categoryId" required class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px]"></select>
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold">SKU</label>
          <input name="sku" maxlength="60"
            class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
        </div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold">Price</label>
          <input name="price" type="number" min="0" step="0.01" required class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold" title="Shown crossed out when higher than the price">Was price</label>
          <input name="compareAtPrice" type="number" min="0" step="0.01" placeholder="Optional" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold">Stock</label>
          <input name="stock" type="number" min="0" step="1" value="0" required class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400 disabled:bg-zinc-100 disabled:text-zinc-500" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold">Unit</label>
          <input name="unitLabel" maxlength="30" value="piece" placeholder="piece" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
        </div>
      </div>
      <p id="product-stock-hint" class="hidden -mt-2 text-[11px] text-zinc-400">Stock is the total of the options below.</p>

      <div class="flex flex-col gap-2 rounded-lg border border-zinc-200 p-3">
        <div class="flex items-center justify-between gap-2">
          <div>
            <div class="text-xs font-semibold">Options</div>
            <div class="text-[11px] text-zinc-400">Sizes and colors merchants pick from. Leave empty for a single-item product.</div>
          </div>
          <button type="button" id="add-variant-btn" class="shrink-0 border border-zinc-200 rounded-lg px-2.5 py-1.5 text-[12px] font-semibold hover:bg-zinc-50">+ Add option</button>
        </div>
        <div id="variants-list" class="flex flex-col gap-2"></div>
      </div>

      <div class="flex flex-col gap-2 rounded-lg border border-zinc-200 p-3">
        <div class="flex items-center justify-between gap-2">
          <div>
            <div class="text-xs font-semibold">Specifications</div>
            <div class="text-[11px] text-zinc-400">Shown on the product page, e.g. Material: Cotton.</div>
          </div>
          <button type="button" id="add-spec-btn" class="shrink-0 border border-zinc-200 rounded-lg px-2.5 py-1.5 text-[12px] font-semibold hover:bg-zinc-50">+ Add spec</button>
        </div>
        <div id="specs-list" class="flex flex-col gap-2"></div>
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Description</label>
        <textarea name="description" rows="2" maxlength="2000"
          class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400"></textarea>
      </div>
      <label class="flex items-center gap-2 text-[13px]">
        <input type="checkbox" name="isFeatured" />
        Feature in “Popular Products” on the shop home
      </label>
      <div class="flex items-center justify-between pt-1">
        <label class="text-xs font-semibold">Status</label>
        <div class="flex items-center bg-zinc-100 border border-zinc-200 rounded-full p-0.5 text-[11.5px] font-semibold">
          <label class="px-3 py-1.5 rounded-full cursor-pointer has-[:checked]:bg-zinc-900 has-[:checked]:text-white">
            <input type="radio" name="status" value="ACTIVE" class="hidden" checked /> Active
          </label>
          <label class="px-3 py-1.5 rounded-full cursor-pointer has-[:checked]:bg-zinc-900 has-[:checked]:text-white">
            <input type="radio" name="status" value="DRAFT" class="hidden" /> Draft
          </label>
        </div>
      </div>
      <p id="product-form-error" class="hidden text-[12.5px] font-medium text-red-600"></p>
    </div>
    <div class="flex gap-2.5 px-5 py-4 border-t border-zinc-200 shrink-0">
      <button type="button" id="product-cancel-btn" class="flex-1 border border-zinc-200 rounded-lg py-2 text-[13px] font-semibold">Cancel</button>
      <button type="submit" id="product-submit-btn" class="flex-1 bg-zinc-900 text-white rounded-lg py-2 text-[13px] font-semibold hover:bg-zinc-800 disabled:opacity-60">Save Product</button>
    </div>
  </form>
</dialog>

<script src="/app.js"></script>
<script>initAdminShell(); initProductsPage();</script>
</body>
</html>
