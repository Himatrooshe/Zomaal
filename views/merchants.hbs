<!doctype html>
<html lang="en">
<head>
{{> head title="Merchants"}}
</head>
<body class="h-dvh flex text-zinc-900 bg-white">
{{> sidebar active="merchants"}}

<div class="flex-1 min-w-0 flex flex-col">
  {{> topbar}}

  <main class="flex-1 min-w-0 overflow-y-auto p-4 sm:p-6 lg:p-8 flex flex-col gap-5">
    <div>
      <h1 class="text-xl font-bold tracking-tight">Merchants</h1>
      <p class="mt-1 text-[13px] text-zinc-500">Every Zomaal store owner — full account management.</p>
    </div>

    <div class="flex flex-wrap items-center gap-2.5">
      <input id="merchant-search" placeholder="Search business name, owner, or phone…"
        class="w-full sm:w-80 border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
      <div class="flex items-center bg-zinc-100 border border-zinc-200 rounded-lg p-0.5 text-[12.5px] font-semibold">
        <button data-active="" class="merchant-status-filter-btn px-3 py-1.5 rounded-md bg-white shadow-sm text-zinc-900">All</button>
        <button data-active="true" class="merchant-status-filter-btn px-3 py-1.5 rounded-md text-zinc-500">Active</button>
        <button data-active="false" class="merchant-status-filter-btn px-3 py-1.5 rounded-md text-zinc-500">Suspended</button>
      </div>
    </div>

    <p id="merchants-error" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-2.5 text-[12.5px] text-red-600"></p>

    <div class="border border-zinc-200 rounded-xl overflow-x-auto">
      <table class="stack w-full text-sm min-w-[640px]">
        <thead>
          <tr class="bg-zinc-50 border-b border-zinc-200 text-left text-[11px] font-semibold text-zinc-400 uppercase tracking-wide">
            <th class="px-4 py-3">Store</th>
            <th class="px-4 py-3">Phone</th>
            <th class="px-4 py-3">Location</th>
            <th class="px-4 py-3">Products</th>
            <th class="px-4 py-3">Customers</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="merchants-tbody">
          <tr><td colspan="7" class="px-4 py-6 text-center text-zinc-400 text-sm">Loading&hellip;</td></tr>
        </tbody>
      </table>
    </div>
  </main>
</div>

{{> merchant_dialog}}

<script src="/app.js"></script>
<script>initAdminShell(); initMerchantsPage();</script>
</body>
</html>
