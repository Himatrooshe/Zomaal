<!doctype html>
<html lang="en">
<head>
{{> head title="Sign in"}}
</head>
<body class="min-h-screen bg-zinc-950 flex items-center justify-center px-4" style="background-image: radial-gradient(circle at 50% -10%, #27272a 0%, #09090b 60%);">

  <div class="w-full max-w-sm bg-white rounded-2xl shadow-2xl p-9 flex flex-col items-center">
    <div class="h-11 w-11 rounded-xl bg-zinc-900 flex items-center justify-center mb-4">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" y1="22" x2="12" y2="12"/></svg>
    </div>
    <h1 class="text-lg font-bold tracking-tight text-zinc-900">Zomaal Admin</h1>
    <p class="mt-1 mb-6 text-[13px] text-zinc-500 text-center">Sign in to manage the Zomaal Shop</p>

    <form id="login-form" class="w-full flex flex-col gap-3.5">
      <div class="flex flex-col gap-1.5">
        <label for="username" class="text-xs font-semibold text-zinc-900">Username</label>
        <input id="username" name="username" autocomplete="username" required
          class="border border-zinc-200 rounded-lg px-3 py-2 text-[13.5px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="password" class="text-xs font-semibold text-zinc-900">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required
          class="border border-zinc-200 rounded-lg px-3 py-2 text-[13.5px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
      </div>

      <p id="login-error" class="hidden text-[12.5px] font-medium text-red-600"></p>

      <button id="login-submit" type="submit" class="mt-1.5 h-[38px] rounded-lg bg-zinc-900 text-white text-[13.5px] font-semibold hover:bg-zinc-800">
        Sign in
      </button>
    </form>

    <div class="w-full border-t border-zinc-100 mt-6 pt-4 flex items-start gap-2">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#a1a1aa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5l-8-3z"/></svg>
      <p class="text-[11.5px] leading-relaxed text-zinc-400">
        Super Admin access only. This single username and password controls the entire system — keep it private.
      </p>
    </div>
  </div>

  <script src="/app.js"></script>
  <script>initLoginPage();</script>
</body>
</html>
