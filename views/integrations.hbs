<!doctype html>
<html lang="en">
<head>
{{> head title="Integrations"}}
</head>
<body class="h-dvh flex text-zinc-900 bg-white">
{{> sidebar active="integrations"}}

<div class="flex-1 min-w-0 flex flex-col">
  {{> topbar}}

  <main class="flex-1 min-w-0 overflow-y-auto p-4 sm:p-6 lg:p-8 flex flex-col gap-5">
    <div>
      <h1 class="text-xl font-bold tracking-tight">Integrations</h1>
      <p class="mt-1 text-[13px] text-zinc-500">Every merchant's Shopify, YouCan and Lightfunnels connection — spot broken syncs before merchants notice.</p>
    </div>

    <div id="integration-summary" class="grid grid-cols-2 lg:grid-cols-4 gap-3"></div>

    <div class="flex flex-wrap items-center gap-2.5">
      <select id="integration-health-filter" class="w-full sm:w-auto border border-zinc-200 rounded-lg px-3 py-2 text-[13px]">
        <option value="">All health states</option>
        <option value="ERROR">Sync error</option>
        <option value="STALE">Stale (no sync in 48h)</option>
        <option value="DISCONNECTED">Disconnected</option>
        <option value="HEALTHY">Healthy</option>
      </select>
      <select id="integration-platform-filter" class="w-full sm:w-auto border border-zinc-200 rounded-lg px-3 py-2 text-[13px]">
        <option value="">All platforms</option>
        <option value="SHOPIFY">Shopify</option>
        <option value="YOUCAN">YouCan</option>
        <option value="LIGHTFUNNELS">Lightfunnels</option>
      </select>
    </div>

    <p id="integrations-error" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-2.5 text-[12.5px] text-red-600"></p>

    <div class="border border-zinc-200 rounded-xl overflow-x-auto">
      <table class="stack w-full text-sm min-w-[640px]">
        <thead><tr class="bg-zinc-50 border-b border-zinc-200 text-left text-[11px] font-semibold text-zinc-400 uppercase tracking-wide">
          <th class="px-4 py-3">Merchant</th><th class="px-4 py-3">Platform</th><th class="px-4 py-3">Health</th><th class="px-4 py-3">Last sync</th><th class="px-4 py-3 text-right">Orders</th>
        </tr></thead>
        <tbody id="integrations-tbody"><tr><td colspan="5" class="px-4 py-6 text-center text-zinc-400">Loading&hellip;</td></tr></tbody>
      </table>
    </div>
  </main>
</div>

<script src="/app.js"></script>
<script>initAdminShell(); initIntegrationsPage();</script>
</body>
</html>
