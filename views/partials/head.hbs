<script src="https://cdn.tailwindcss.com"></script>
<style>
  body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
  ::placeholder { color: #a1a1aa; }

  /* Phones: tables marked .stack turn each row into a labelled card, so no
     column (health, stock, actions…) is hidden off-screen behind a sideways
     scroll. Labels come from the column headers (set by labelStackTables()
     in app.js). Tablet and up keep the normal table. */
  @media (max-width: 767px) {
    table.stack { min-width: 0 !important; }
    table.stack thead { display: none; }
    table.stack tbody, table.stack tr, table.stack td { display: block; width: 100%; }
    table.stack tr { padding: 12px 16px; }
    table.stack td { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 16px; row-gap: 4px; align-items: start; justify-items: end; padding: 5px 0 !important; text-align: right !important; }
    table.stack td::before { content: attr(data-label); grid-column: 1; grid-row: 1; justify-self: start; text-align: left; color: #71717a; font-size: 12px; font-weight: 500; line-height: 20px; }
    table.stack td > * { grid-column: 2; min-width: 0; }
    /* justify-items: normal — Chrome applies justify-items to block layout too,
       so without this the inherited `end` shoves the title block right. */
    table.stack td.stack-primary { display: block; justify-items: normal; text-align: left !important; padding-bottom: 8px !important; }
    table.stack td.stack-primary::before, table.stack td.stack-full::before { content: none; }
    table.stack td.stack-full { display: block; justify-items: normal; text-align: center !important; }
    table.stack td.stack-actions::before { content: none; }
    table.stack td.stack-actions { display: flex; justify-content: flex-end; padding-top: 8px !important; }
  }
</style>
