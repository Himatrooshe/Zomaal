<!doctype html>
<html lang="en">
<head>
{{> head title="Shop Settings"}}
</head>
<body class="h-dvh flex text-zinc-900 bg-white">
{{> sidebar active="shop-settings"}}

<div class="flex-1 min-w-0 flex flex-col">
  {{> topbar}}

  <main class="flex-1 min-w-0 overflow-y-auto p-4 sm:p-6 lg:p-8 flex flex-col gap-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h1 class="text-xl font-bold tracking-tight">Shop Settings</h1>
        <p class="mt-1 text-[13px] text-zinc-500">Delivery fees and payment rules for the Zomaal Shop.</p>
      </div>

    </div>
    <form id="shop-settings-form" class="w-full max-w-[560px] flex flex-col gap-5">
      <section class="border border-zinc-200 rounded-xl overflow-hidden">
        <div class="border-b border-zinc-200 px-5 py-4">
          <div class="text-sm font-bold">Pricing &amp; delivery</div>
          <div class="mt-0.5 text-xs text-zinc-400">Applied to every new order. Existing orders keep the amounts they were placed with.</div>
        </div>
        <div class="px-5 py-[18px] flex flex-col gap-3.5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Currency</label>
        <input name="currency" required pattern="[A-Za-z]{3}" maxlength="3" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400 uppercase" />
        <span class="text-[11px] text-zinc-400">3-letter code, e.g. MAD</span>
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Delivery fee</label>
        <input name="deliveryFee" type="number" min="0" step="0.01" required class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
      </div>
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Free delivery from subtotal</label>
        <input name="freeDeliveryMinSubtotal" type="number" min="0" step="0.01" placeholder="Never free" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
        <span class="text-[11px] text-zinc-400">Orders at or above this subtotal (before discount) ship free. Leave empty to always charge delivery.</span>
      </div>
        </div>
      </section>

      <section class="border border-zinc-200 rounded-xl overflow-hidden">
        <div class="border-b border-zinc-200 px-5 py-4">
          <div class="text-sm font-bold">Payment</div>
          <div class="mt-0.5 text-xs text-zinc-400">Online payment isn't connected yet, so Cash on Delivery is the only way to pay.</div>
        </div>
        <div class="px-5 py-[18px] flex flex-col gap-3.5">
          <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" name="codEnabled" /> Accept Cash on Delivery</label>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Pause COD after</label>
        <input name="codCancellationLimit" type="number" min="0" max="100" step="1" required class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
        <span class="text-[11px] text-zinc-400">cancelled or refused orders · 0 = never pause</span>
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Counted over the last</label>
        <input name="codCancellationWindowDays" type="number" min="1" max="365" step="1" required class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
        <span class="text-[11px] text-zinc-400">days</span>
      </div>
      </div>
        </div>
      </section>

      <div class="flex items-center gap-3">
        <button type="submit" class="bg-zinc-900 text-white rounded-lg px-4 py-2 text-[13px] font-semibold hover:bg-zinc-800 disabled:opacity-60">Save settings</button>
        <span id="shop-settings-status" class="hidden text-[12.5px] font-medium"></span>
      </div>
      <p id="shop-settings-updated" class="text-[11.5px] text-zinc-400"></p>
    </form>
  </main>
</div>

<script src="/app.js"></script>
<script>initAdminShell(); initShopSettingsPage();</script>
</body>
</html>
