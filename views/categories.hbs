<!doctype html>
<html lang="en">
<head>
{{> head title="Categories"}}
</head>
<body class="h-dvh flex text-zinc-900 bg-white">
{{> sidebar active="categories"}}

<div class="flex-1 min-w-0 flex flex-col">
  {{> topbar}}

  <main class="flex-1 min-w-0 overflow-y-auto p-4 sm:p-6 lg:p-8 flex flex-col gap-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h1 class="text-xl font-bold tracking-tight">Categories</h1>
        <p class="mt-1 text-[13px] text-zinc-500">Group products so merchants can browse the shop easily.</p>
      </div>
      <button id="add-category-btn" class="flex items-center gap-2 bg-zinc-900 text-white rounded-lg px-4 py-2 text-[13px] font-semibold hover:bg-zinc-800">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Category
      </button>
    </div>

    <p id="categories-error" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-2.5 text-[12.5px] text-red-600"></p>

    <div id="categories-grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3 sm:gap-4">
      <div class="col-span-full text-sm text-zinc-400">Loading&hellip;</div>
    </div>
  </main>
</div>

<dialog id="category-dialog" class="rounded-xl p-0 w-[calc(100%-2rem)] max-w-[420px] backdrop:bg-zinc-900/40">
  <form id="category-form" class="flex flex-col">
    <div class="px-5 py-4 border-b border-zinc-200">
      <div id="category-dialog-title" class="text-sm font-bold">Add Category</div>
    </div>
    <div class="px-5 py-[18px] flex flex-col gap-3.5">
      <input type="hidden" name="id" />
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Name</label>
        <input name="name" required maxlength="100"
          class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Sort Order</label>
        <input name="sortOrder" type="number" min="0" value="0"
          class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
      </div>
      <label id="category-active-row" class="hidden items-center gap-2 text-[13px]">
        <input type="checkbox" name="isActive" checked />
        Active
      </label>
      <p id="category-form-error" class="hidden text-[12.5px] font-medium text-red-600"></p>
    </div>
    <div class="flex gap-2.5 px-5 py-4 border-t border-zinc-200">
      <button type="button" id="category-cancel-btn" class="flex-1 border border-zinc-200 rounded-lg py-2 text-[13px] font-semibold">Cancel</button>
      <button type="submit" class="flex-1 bg-zinc-900 text-white rounded-lg py-2 text-[13px] font-semibold hover:bg-zinc-800">Save</button>
    </div>
  </form>
</dialog>

<script src="/app.js"></script>
<script>initAdminShell(); initCategoriesPage();</script>
</body>
</html>
