<!doctype html>
<html lang="en">
<head>
{{> head title="Shop Banners"}}
</head>
<body class="h-dvh flex text-zinc-900 bg-white">
{{> sidebar active="banners"}}

<div class="flex-1 min-w-0 flex flex-col">
  {{> topbar}}

  <main class="flex-1 min-w-0 overflow-y-auto p-4 sm:p-6 lg:p-8 flex flex-col gap-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h1 class="text-xl font-bold tracking-tight">Banners</h1>
        <p class="mt-1 text-[13px] text-zinc-500">The slides at the top of the Zomaal Shop home screen.</p>
      </div>
      <button id="add-banner-btn" class="flex items-center gap-2 bg-zinc-900 text-white rounded-lg px-4 py-2 text-[13px] font-semibold hover:bg-zinc-800">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Banner
      </button>
    </div>
    <p id="banners-error" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-2.5 text-[12.5px] text-red-600"></p>
    <p id="banners-notice" class="hidden rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-2.5 text-[12.5px] text-emerald-700"></p>
    <div id="banners-grid" class="grid grid-cols-1 md:grid-cols-2 2xl:grid-cols-3 gap-4">
      <div class="col-span-full text-sm text-zinc-400">Loading&hellip;</div>
    </div>
  </main>
</div>

<dialog id="banner-dialog" class="rounded-xl p-0 w-[calc(100%-2rem)] max-w-[520px] backdrop:bg-zinc-900/40">
  <form id="banner-form" class="flex flex-col max-h-[85vh]">
    <div class="px-5 py-4 border-b border-zinc-200 shrink-0"><div id="banner-dialog-title" class="text-sm font-bold">Add Banner</div></div>
    <div class="px-5 py-[18px] flex flex-col gap-3.5 overflow-y-auto">
      <input type="hidden" name="id" />
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Image</label>
        <div id="banner-image-preview" class="hidden aspect-[2/1] overflow-hidden rounded-lg border border-zinc-200 bg-zinc-100"><img class="h-full w-full object-cover" alt="" /></div>
        <input name="image" type="file" accept="image/jpeg,image/png,image/webp" class="text-[12.5px] file:mr-3 file:rounded-md file:border file:border-zinc-200 file:bg-white file:px-3 file:py-1.5 file:text-[12px] file:font-semibold" />
        <span class="text-[11px] text-zinc-400">Wide image, about 2:1 (e.g. 1200×600). JPEG, PNG or WebP, max 5 MB. A banner only shows once it has an image.</span>
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Title</label>
        <input name="title" maxlength="80" placeholder="e.g. Packaging week — 20% off" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Subtitle</label>
        <input name="subtitle" maxlength="120" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Opens</label>
        <select name="linkType" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400">
          <option value="NONE">Nothing (just an image)</option>
          <option value="PRODUCT">A product</option>
          <option value="CATEGORY">A category</option>
        </select>
      </div>
      <div id="banner-link-row" class="hidden flex-col gap-1.5">
        <label id="banner-link-label" class="text-xs font-semibold">Product</label>
        <select name="linkId" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400"></select>
      </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Starts</label>
        <input name="startsAt" type="datetime-local" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
        <span class="text-[11px] text-zinc-400">Empty = right away</span>
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Ends</label>
        <input name="endsAt" type="datetime-local" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
        <span class="text-[11px] text-zinc-400">Empty = no end</span>
      </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Position</label>
        <input name="sortOrder" type="number" min="0" value="0" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
        <span class="text-[11px] text-zinc-400">Lower shows first</span>
      </div>
      <label class="flex items-center gap-2 text-[13px] sm:pt-6">
        <input type="checkbox" name="isActive" checked /> Active
      </label>
      </div>
      <p id="banner-form-error" class="hidden text-[12.5px] font-medium text-red-600"></p>
    </div>
    <div class="flex gap-2.5 px-5 py-4 border-t border-zinc-200 shrink-0">
      <button type="button" data-close class="flex-1 border border-zinc-200 rounded-lg py-2 text-[13px] font-semibold">Cancel</button>
      <button type="submit" class="flex-1 bg-zinc-900 text-white rounded-lg py-2 text-[13px] font-semibold hover:bg-zinc-800 disabled:opacity-60">Save Banner</button>
    </div>
  </form>
</dialog>
<script src="/app.js"></script>
<script>initAdminShell(); initBannersPage();</script>
</body>
</html>
