<!doctype html>
<html lang="en">
<head>
{{> head title="Promo Codes"}}
</head>
<body class="h-dvh flex text-zinc-900 bg-white">
{{> sidebar active="promo-codes"}}

<div class="flex-1 min-w-0 flex flex-col">
  {{> topbar}}

  <main class="flex-1 min-w-0 overflow-y-auto p-4 sm:p-6 lg:p-8 flex flex-col gap-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h1 class="text-xl font-bold tracking-tight">Promo Codes</h1>
        <p class="mt-1 text-[13px] text-zinc-500">Discount codes merchants can enter at checkout.</p>
      </div>
      <button id="add-promo-btn" class="flex items-center gap-2 bg-zinc-900 text-white rounded-lg px-4 py-2 text-[13px] font-semibold hover:bg-zinc-800">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Promo Code
      </button>
    </div>
    <p id="promos-error" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-2.5 text-[12.5px] text-red-600"></p>
    <p id="promos-notice" class="hidden rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-2.5 text-[12.5px] text-emerald-700"></p>
    <div class="border border-zinc-200 rounded-xl overflow-x-auto">
      <table class="stack w-full text-sm min-w-[760px]">
        <thead>
          <tr class="bg-zinc-50 border-b border-zinc-200 text-left text-[11px] font-semibold text-zinc-400 uppercase tracking-wide">
            <th class="px-4 py-3">Code</th>
            <th class="px-4 py-3">Discount</th>
            <th class="px-4 py-3">Rules</th>
            <th class="px-4 py-3">Usage</th>
            <th class="px-4 py-3">Valid</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="promos-tbody">
          <tr><td colspan="7" class="px-4 py-6 text-center text-zinc-400 text-sm">Loading&hellip;</td></tr>
        </tbody>
      </table>
    </div>
  </main>
</div>

<dialog id="promo-dialog" class="rounded-xl p-0 w-[calc(100%-2rem)] max-w-[560px] backdrop:bg-zinc-900/40">
  <form id="promo-form" class="flex flex-col max-h-[85vh]">
    <div class="px-5 py-4 border-b border-zinc-200 shrink-0"><div id="promo-dialog-title" class="text-sm font-bold">Add Promo Code</div></div>
    <div class="px-5 py-[18px] flex flex-col gap-3.5 overflow-y-auto">
      <input type="hidden" name="id" />
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Code</label>
        <input name="code" required pattern="[A-Za-z0-9_\-]{3,40}" maxlength="40" placeholder="SUMMER20" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400 uppercase" />
        <span class="text-[11px] text-zinc-400">Letters, digits, - or _</span>
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Discount type</label>
        <select name="type" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400">
          <option value="PERCENT">Percentage off</option>
          <option value="FIXED">Fixed amount off</option>
        </select>
      </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold"><span id="promo-value-label">Percent off</span></label>
        <input name="value" type="number" min="0.01" step="0.01" required class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
      </div>
      <div id="promo-max-row" class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Max discount</label>
        <input name="maxDiscount" type="number" min="0" step="0.01" placeholder="No cap" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
      </div>
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Description</label>
        <input name="description" maxlength="200" placeholder="Internal note, also shown to merchants" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Minimum order subtotal</label>
        <input name="minSubtotal" type="number" min="0" step="0.01" placeholder="None" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Total uses</label>
        <input name="usageLimit" type="number" min="1" step="1" placeholder="Unlimited" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
      </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Uses per merchant</label>
        <input name="perStoreLimit" type="number" min="1" step="1" placeholder="Unlimited" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
      </div>
      <label class="flex items-center gap-2 text-[13px] sm:pt-6">
        <input type="checkbox" name="isActive" checked /> Active
      </label>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Starts</label>
        <input name="startsAt" type="datetime-local" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
        <span class="text-[11px] text-zinc-400">Empty = right away</span>
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-semibold">Ends</label>
        <input name="endsAt" type="datetime-local" class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
        <span class="text-[11px] text-zinc-400">Empty = no end</span>
      </div>
      </div>
      <p id="promo-form-error" class="hidden text-[12.5px] font-medium text-red-600"></p>
    </div>
    <div class="flex gap-2.5 px-5 py-4 border-t border-zinc-200 shrink-0">
      <button type="button" data-close class="flex-1 border border-zinc-200 rounded-lg py-2 text-[13px] font-semibold">Cancel</button>
      <button type="submit" class="flex-1 bg-zinc-900 text-white rounded-lg py-2 text-[13px] font-semibold hover:bg-zinc-800 disabled:opacity-60">Save Code</button>
    </div>
  </form>
</dialog>
<script src="/app.js"></script>
<script>initAdminShell(); initPromoCodesPage();</script>
</body>
</html>
