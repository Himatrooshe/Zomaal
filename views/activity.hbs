<!doctype html>
<html lang="en">
<head>
{{> head title="Activity Log"}}
</head>
<body class="h-dvh flex text-zinc-900 bg-white">
{{> sidebar active="activity"}}

<div class="flex-1 min-w-0 flex flex-col">
  {{> topbar}}

  <main class="flex-1 min-w-0 overflow-y-auto p-4 sm:p-6 lg:p-8 flex flex-col gap-5">
    <div>
      <h1 class="text-xl font-bold tracking-tight">Activity Log</h1>
      <p class="mt-1 text-[13px] text-zinc-500">Every change made from this admin panel — who, what, and when. Entries are permanent and survive deletions.</p>
    </div>

    <div class="flex items-center gap-2.5">
      <select id="activity-type-filter" class="w-full sm:w-auto border border-zinc-200 rounded-lg px-3 py-2 text-[13px]">
        <option value="">All activity</option>
        <option value="MERCHANT">Merchants</option>
        <option value="SHOP_PRODUCT">Products</option>
        <option value="SHOP_CATEGORY">Categories</option>
        <option value="ADMIN">Admin account</option>
      </select>
    </div>

    <p id="activity-error" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-2.5 text-[12.5px] text-red-600"></p>

    <div class="border border-zinc-200 rounded-xl overflow-x-auto">
      <table class="stack w-full text-sm min-w-[640px]">
        <thead><tr class="bg-zinc-50 border-b border-zinc-200 text-left text-[11px] font-semibold text-zinc-400 uppercase tracking-wide">
          <th class="px-4 py-3 w-44">When</th><th class="px-4 py-3">What happened</th><th class="px-4 py-3 w-40">Action</th><th class="px-4 py-3 w-32">By</th>
        </tr></thead>
        <tbody id="activity-tbody"><tr><td colspan="4" class="px-4 py-6 text-center text-zinc-400">Loading&hellip;</td></tr></tbody>
      </table>
    </div>

    <button id="activity-more-btn" class="hidden self-center border border-zinc-200 rounded-lg px-4 py-2 text-[13px] font-semibold hover:bg-zinc-50">Load more</button>
  </main>
</div>

<script src="/app.js"></script>
<script>initAdminShell(); initActivityPage();</script>
</body>
</html>
