<!doctype html>
<html lang="en">
<head>
{{> head title="Shop Orders"}}
</head>
<body class="h-dvh flex text-zinc-900 bg-white">
{{> sidebar active="orders"}}

<div class="flex-1 min-w-0 flex flex-col">
  {{> topbar}}

  <main class="flex-1 min-w-0 overflow-y-auto p-4 sm:p-6 lg:p-8 flex flex-col gap-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h1 class="text-xl font-bold tracking-tight">Shop Orders</h1>
        <p class="mt-1 text-[13px] text-zinc-500">Orders merchants placed in the Zomaal Shop. Confirm, ship and deliver them here.</p>
      </div>
      <button id="export-orders-btn" class="border border-zinc-200 rounded-lg px-3.5 py-2 text-[13px] font-semibold hover:bg-zinc-50">Export CSV</button>
    </div>

    <div class="flex flex-col gap-2.5 lg:flex-row lg:items-center">
      <input id="order-search" placeholder="Search order #, merchant or phone…"
        class="w-full lg:w-[300px] border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
      <div class="overflow-x-auto -mx-1 px-1">
        <div id="order-status-tabs" class="flex w-max items-center bg-zinc-100 border border-zinc-200 rounded-lg p-0.5 text-[12.5px] font-semibold">
          <button data-status="" class="order-status-btn px-3 py-1.5 rounded-md bg-white shadow-sm text-zinc-900">All <span class="count text-zinc-400 font-medium"></span></button>
          <button data-status="PENDING" class="order-status-btn px-3 py-1.5 rounded-md text-zinc-500">Pending <span class="count text-zinc-400 font-medium"></span></button>
          <button data-status="CONFIRMED" class="order-status-btn px-3 py-1.5 rounded-md text-zinc-500">Confirmed <span class="count text-zinc-400 font-medium"></span></button>
          <button data-status="SHIPPED" class="order-status-btn px-3 py-1.5 rounded-md text-zinc-500">Shipped <span class="count text-zinc-400 font-medium"></span></button>
          <button data-status="DELIVERED" class="order-status-btn px-3 py-1.5 rounded-md text-zinc-500">Delivered <span class="count text-zinc-400 font-medium"></span></button>
          <button data-status="CANCELLED" class="order-status-btn px-3 py-1.5 rounded-md text-zinc-500">Cancelled <span class="count text-zinc-400 font-medium"></span></button>
        </div>
      </div>
    </div>

    <p id="orders-error" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-2.5 text-[12.5px] text-red-600"></p>

    <div class="border border-zinc-200 rounded-xl overflow-x-auto">
      <table class="stack w-full text-sm min-w-[720px]">
        <thead>
          <tr class="bg-zinc-50 border-b border-zinc-200 text-left text-[11px] font-semibold text-zinc-400 uppercase tracking-wide">
            <th class="px-4 py-3">Order</th>
            <th class="px-4 py-3">Merchant</th>
            <th class="px-4 py-3">Items</th>
            <th class="px-4 py-3">Total</th>
            <th class="px-4 py-3">Payment</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3 text-right">Placed</th>
          </tr>
        </thead>
        <tbody id="orders-tbody">
          <tr><td colspan="7" class="px-4 py-6 text-center text-zinc-400 text-sm">Loading&hellip;</td></tr>
        </tbody>
      </table>
    </div>

    <div class="flex items-center justify-between text-[12.5px] text-zinc-500">
      <span id="orders-range"></span>
      <div class="flex gap-2">
        <button id="orders-prev" class="border border-zinc-200 rounded-lg px-3 py-1.5 font-semibold disabled:opacity-40" disabled>Previous</button>
        <button id="orders-next" class="border border-zinc-200 rounded-lg px-3 py-1.5 font-semibold disabled:opacity-40" disabled>Next</button>
      </div>
    </div>
  </main>
</div>

<script src="/app.js"></script>
<script>initAdminShell(); initOrdersPage();</script>
</body>
</html>
