<!doctype html>
<html lang="en">
<head>
{{> head title="Settings"}}
</head>
<body class="h-dvh flex text-zinc-900 bg-white">
{{> sidebar active="settings"}}

<div class="flex-1 min-w-0 flex flex-col">
  {{> topbar}}

  <main class="flex-1 min-w-0 overflow-y-auto p-4 sm:p-6 lg:p-8 flex flex-col items-start gap-6">
    <div>
      <h1 class="text-xl font-bold tracking-tight">Settings</h1>
      <p class="mt-1 text-[13px] text-zinc-500">Manage the single Super Admin identity for the platform.</p>
    </div>

    <div class="w-full max-w-[520px] border border-zinc-200 rounded-xl overflow-hidden">
      <div class="border-b border-zinc-200 px-5 py-4">
        <div class="text-sm font-bold">Super Admin Account</div>
        <div class="mt-0.5 text-xs text-zinc-400">This single username and password controls the entire system.</div>
      </div>
      <div class="px-5 py-[18px]">
        <label class="text-xs font-semibold text-zinc-900 mb-1.5 block">Username</label>
        <input id="settings-username" disabled value="…"
          class="w-full border border-zinc-200 rounded-lg px-3 py-2 text-[13px] bg-zinc-50 text-zinc-500" />
      </div>
    </div>

    <div class="w-full max-w-[520px] border border-zinc-200 rounded-xl overflow-hidden">
      <div class="border-b border-zinc-200 px-5 py-4">
        <div class="text-sm font-bold">Change Password</div>
        <div class="mt-0.5 text-xs text-zinc-400">Choose a strong password — this account has full system access.</div>
      </div>
      <form id="change-password-form" class="px-5 py-[18px] flex flex-col gap-3.5">
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-zinc-900">Current Password</label>
          <input name="currentPassword" type="password" required
            class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-zinc-900">New Password</label>
          <input name="newPassword" type="password" minlength="8" required
            class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-zinc-900">Confirm New Password</label>
          <input name="confirmPassword" type="password" minlength="8" required
            class="border border-zinc-200 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-400" />
        </div>

        <p id="password-status" class="hidden text-[12.5px] font-medium"></p>

        <div class="flex justify-end pt-1">
          <button type="submit" class="bg-zinc-900 text-white rounded-lg px-[18px] py-2 text-[13px] font-semibold hover:bg-zinc-800">
            Update Password
          </button>
        </div>
      </form>
    </div>
  </main>
</div>

<script src="/app.js"></script>
<script>initAdminShell(); initSettingsPage();</script>
</body>
</html>
