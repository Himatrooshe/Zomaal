##########################################
# Application
##########################################

NODE_ENV=production

# Cloud Run provides PORT automatically
SWAGGER_ENABLED=true
WEBHOOK_DEBUG_ENABLED=false

# Shown on Settings → About this App / Privacy Policy (optional; null in API if unset)
APP_NAME=Zomaal
APP_VERSION=1.0.0
PRIVACY_POLICY_URL=
ABOUT_APP_URL=
TERMS_OF_SERVICE_URL=
SUPPORT_EMAIL=

# Update when frontend is deployed
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082

##########################################
# Database
##########################################

DATABASE_URL=postgresql://zomaal:YOUR_URL_ENCODED_PASSWORD@localhost/zomaal?host=/cloudsql/zomaal:us-central1:zomaal-db&schema=public

##########################################
# Authentication
##########################################

JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET

##########################################
# Development
##########################################

DEV_OTP_ENABLED=false
DEV_OTP_CODE=

##########################################
# Redis
##########################################

# Prefer REDIS_URL in production. Include the AUTH password in the URL.
REDIS_URL=redis://:YOUR_REDIS_AUTH@YOUR_REDIS_HOST:6379
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=6379
REDIS_REQUIRED=true
REDIS_CONNECT_TIMEOUT_MS=15000
REDIS_RECONNECT_MAX_ATTEMPTS=20
REDIS_RECONNECT_MAX_DELAY_MS=5000

##########################################
# Scheduled e-commerce synchronization
##########################################

ECOMMERCE_SYNC_SCHEDULER_ENABLED=false
ECOMMERCE_SYNC_SCHEDULER_SECRET=YOUR_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
ECOMMERCE_SYNC_CONCURRENCY=2
ECOMMERCE_SYNC_MAX_CONNECTIONS=100
ECOMMERCE_SYNC_MIN_INTERVAL_MINUTES=15

##########################################
# Merchant warehouse product media
##########################################

PRODUCT_IMAGE_BUCKET=zomaal-product-images-prod-zomaal

##########################################
# Twilio
##########################################

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=
# Comma-separated ISO country codes where a channel is blocked in Twilio
# Verify Geo-Permissions (e.g. MA). Shown as sms/whatsapp=false on GET /auth/countries.
OTP_SMS_DISABLED_COUNTRIES=
OTP_WHATSAPP_DISABLED_COUNTRIES=
# Country preselected in the phone picker (defaults to MA)
OTP_DEFAULT_COUNTRY=

##########################################
# Sendit.ma
##########################################

SENDIT_API_BASE_URL=https://app.sendit.ma/api/v1
SENDIT_PUBLIC_KEY=
SENDIT_SECRET_KEY=
SENDIT_TOKEN_TTL_SECONDS=3300
SENDIT_API_TIMEOUT_MS=10000

SHIPPING_CREDENTIAL_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY

##########################################
# QuickLivraison
##########################################

QUICKLIVRAISON_API_BASE_URL=https://clients.quicklivraison.ma/api
QUICKLIVRAISON_API_KEY=
QUICKLIVRAISON_WEBHOOK_SECRET=
QUICKLIVRAISON_SYNC_SCHEDULER_ENABLED=false
QUICKLIVRAISON_SYNC_SCHEDULER_SECRET=
QUICKLIVRAISON_SYNC_CONCURRENCY=2
QUICKLIVRAISON_SYNC_MAX_CONNECTIONS=100
QUICKLIVRAISON_SYNC_MIN_INTERVAL_MINUTES=15

##########################################
# ForceLog
##########################################

FORCELOG_API_BASE_URL=https://api.forcelog.ma/customer
FORCELOG_HEALTH_BASE_URL=https://api.forcelog.ma
FORCELOG_API_KEY=

##########################################
# Ozone Express
##########################################

OZONEEXPRESS_API_BASE_URL=https://api.ozonexpress.ma
OZONEEXPRESS_CLIENT_BASE_URL=https://client.ozoneexpress.ma

# Ameex API. Per-user API IDs and keys are encrypted in the database.
AMEEX_API_BASE_URL=https://api.ameex.app/customer
AMEEX_API_TIMEOUT_MS=10000
OZONEEXPRESS_CUSTOMER_ID=
OZONEEXPRESS_API_KEY=

##########################################
# Shopify
##########################################

SHOPIFY_ENABLED=true

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

SHOPIFY_APP_URL=https://zomaal-backend-828793303867.us-central1.run.app

SHOPIFY_SCOPES=read_products,read_orders,read_customers

SHOPIFY_REDIRECT_URI=https://zomaal-backend-828793303867.us-central1.run.app/auth/shopify/callback

SHOPIFY_API_VERSION=2026-07

SHOPIFY_OAUTH_STATE_TTL_SECONDS=600
SHOPIFY_TOKEN_REFRESH_SKEW_SECONDS=300
SHOPIFY_HTTP_TIMEOUT_MS=15000

SHOPIFY_TOKEN_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY

SHOPIFY_AUTH_SUCCESS_REDIRECT_URL=http://localhost:8081/settings/integrations/shopify
SHOPIFY_AUTH_FAILURE_REDIRECT_URL=http://localhost:8081/settings/integrations/shopify

##########################################
# Logger
##########################################

LOGGER_PHONE=
LOGGER_PASSWORD=

##########################################
# Zomaal Shop admin panel (super admin)
##########################################

# Single super-admin identity for the whole system. Both must be set
# together. The password is only a first-boot seed — after that the admin
# changes it in Settings, and restarts don't revert it.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
# Lost the password? Set to true for ONE boot to re-apply
# SUPERADMIN_PASSWORD (and sign out all sessions), then remove it.
SUPERADMIN_PASSWORD_RESET=

# Separate signing secret so a merchant token can never authenticate as the
# admin panel and vice versa. Falls back to JWT_SECRET if unset (dev only —
# always set a dedicated 32+ char secret in production).
SUPER_ADMIN_JWT_SECRET=

# Where Zomaal Shop product images are stored: "gcs" (PRODUCT_IMAGE_BUCKET)
# or "local" (disk, under SHOP_IMAGE_LOCAL_DIR). Defaults to gcs in
# production and local everywhere else. "local" is refused in production.
SHOP_IMAGE_STORAGE=
SHOP_IMAGE_LOCAL_DIR=

##########################################
# YouCan
##########################################

YOUCAN_ENABLED=true

YOUCAN_CLIENT_ID=2942
YOUCAN_CLIENT_SECRET=

YOUCAN_APP_URL=https://zomaal-backend-828793303867.us-central1.run.app

YOUCAN_REDIRECT_URI=https://zomaal-backend-828793303867.us-central1.run.app/auth/youcan/callback

YOUCAN_TOKEN_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY

YOUCAN_SCOPES=*

YOUCAN_OAUTH_STATE_TTL_SECONDS=600
YOUCAN_TOKEN_REFRESH_SKEW_SECONDS=300
YOUCAN_HTTP_TIMEOUT_MS=15000

YOUCAN_AUTH_SUCCESS_REDIRECT_URL=http://localhost:8081/settings/integrations/youcan
YOUCAN_AUTH_FAILURE_REDIRECT_URL=http://localhost:8081/settings/integrations/youcan

##########################################
# Lightfunnels
##########################################

LIGHTFUNNELS_ENABLED=true

LIGHTFUNNELS_CLIENT_ID=
LIGHTFUNNELS_CLIENT_SECRET=

LIGHTFUNNELS_APP_URL=https://zomaal-backend-828793303867.us-central1.run.app

LIGHTFUNNELS_REDIRECT_URI=https://zomaal-backend-828793303867.us-central1.run.app/auth/lightfunnels/callback

LIGHTFUNNELS_TOKEN_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY

LIGHTFUNNELS_OAUTH_STATE_TTL_SECONDS=600
LIGHTFUNNELS_HTTP_TIMEOUT_MS=15000
LIGHTFUNNELS_SCOPES=orders,funnels,products,customers

LIGHTFUNNELS_AUTH_SUCCESS_REDIRECT_URL=http://localhost:8081/settings/integrations/lightfunnels
LIGHTFUNNELS_AUTH_FAILURE_REDIRECT_URL=http://localhost:8081/settings/integrations/lightfunnels

##########################################
# TikTok Ads
##########################################

TIKTOK_ADS_ENABLED=true

TIKTOK_ADS_APP_ID=
TIKTOK_ADS_APP_SECRET=

TIKTOK_ADS_REDIRECT_URI=https://zomaal-backend-828793303867.us-central1.run.app/auth/tiktok/callback

TIKTOK_ADS_OAUTH_STATE_TTL_SECONDS=600
TIKTOK_ADS_HTTP_TIMEOUT_MS=15000

# Shared across every ad platform (TikTok now, Meta/Google/Snapchat later)
ADS_TOKEN_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY

TIKTOK_ADS_AUTH_SUCCESS_REDIRECT_URL=http://localhost:8081/settings/integrations/tiktok-ads
TIKTOK_ADS_AUTH_FAILURE_REDIRECT_URL=http://localhost:8081/settings/integrations/tiktok-ads

# Cloud Scheduler calls POST /internal/ads/{tiktok,google,meta}/sync with the
# x-zomaal-scheduler-secret header. Production: scripts/setup-ads-scheduler.sh
ADS_SYNC_SCHEDULER_ENABLED=false
ADS_SYNC_SCHEDULER_SECRET=YOUR_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS

##########################################
# Google Ads
##########################################
# Setup: Google Cloud -> enable "Google Ads API" and check the access level on
# its Overview page (Explorer or higher for production accounts); OAuth consent
# screen with scope https://www.googleapis.com/auth/adwords, OAuth client (Web
# application) in that same project with the redirect URI below.
# Keep real values in Secret Manager.
GOOGLE_ADS_ENABLED=false
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Optional: developer tokens were sunset on 2026-09-09; Google ignores them.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=http://localhost:3001/auth/google-ads/callback
# Optional: manager account id (digits) when testing through a test manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_OAUTH_STATE_TTL_SECONDS=600
GOOGLE_ADS_HTTP_TIMEOUT_MS=20000
GOOGLE_ADS_AUTH_SUCCESS_REDIRECT_URL=http://localhost:8081/settings/integrations/google-ads
GOOGLE_ADS_AUTH_FAILURE_REDIRECT_URL=http://localhost:8081/settings/integrations/google-ads

##########################################
# Meta Ads (Facebook / Instagram)
##########################################
# Setup: Meta app (type Business) with the "Marketing API" and "Facebook Login
# for Business" products. Add the redirect URI below to "Valid OAuth Redirect
# URIs". Permissions: ads_read (required) and ads_management (pause/resume) —
# both need Advanced Access through App Review before real merchants can connect.
# The app id/secret fall back to META_APP_ID / META_APP_SECRET when the same
# Meta app also runs WhatsApp. Keep real values in Secret Manager.
META_ADS_ENABLED=false
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_REDIRECT_URI=http://localhost:3001/auth/meta-ads/callback
# Optional: Facebook Login for Business configuration id (replaces the scope list).
META_ADS_CONFIG_ID=
META_ADS_API_VERSION=v25.0
META_ADS_OAUTH_STATE_TTL_SECONDS=600
META_ADS_HTTP_TIMEOUT_MS=20000
META_ADS_AUTH_SUCCESS_REDIRECT_URL=http://localhost:8081/settings/integrations/meta-ads
META_ADS_AUTH_FAILURE_REDIRECT_URL=http://localhost:8081/settings/integrations/meta-ads

##########################################
# WhatsApp automation (Meta Cloud API, Embedded Signup)
##########################################
# Meta app with the WhatsApp product, approved as a Tech Provider.
# Webhook callback URL in the Meta app dashboard: https://<backend>/webhooks/whatsapp
WHATSAPP_ENABLED=false
META_APP_ID=
META_APP_SECRET=
# Embedded Signup "Facebook Login for Business" configuration id.
META_WHATSAPP_CONFIG_ID=
# Any random string; paste the same value as the webhook "Verify token" in Meta.
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
# base64 32-byte key: openssl rand -base64 32
WHATSAPP_TOKEN_ENCRYPTION_KEY=
# Invoke POST /internal/whatsapp/dispatch every minute to send due messages.
WHATSAPP_SCHEDULER_ENABLED=false
WHATSAPP_SCHEDULER_SECRET=
# Low-balance alert when the balance covers fewer than this many messages.
WHATSAPP_LOW_BALANCE_MESSAGES=20
# Courier statuses older than this are not messaged (old parcel refreshes).
WHATSAPP_MAX_STATUS_AGE_HOURS=24
# TEMPORARY: true = /whatsapp/* returns static preview data for the frontend
# (no Meta, no DB writes). Must be false when WHATSAPP_ENABLED=true.
WHATSAPP_MOCK_DATA=false

# Recurring salary obligations: invoke POST /internal/staff-salary/run daily.
# Enabling this never transfers money; it creates PENDING obligations only.
STAFF_SALARY_SCHEDULER_ENABLED=false
STAFF_SALARY_SCHEDULER_SECRET=

# Notifications: invoke POST /internal/notifications/run every five minutes to
# evaluate low stock, overdue salary, sales drop and connection health.
NOTIFICATIONS_SCHEDULER_ENABLED=false
NOTIFICATIONS_SCHEDULER_SECRET=
# TEMPORARY CLIENT DEPENDENCY: Meta must approve the owner's inventory alert
# template before real delivery. Leave the name empty until supplied/approved.
# Body variables: material name, available stock, minimum level, unit.
# Uses the store's active WhatsApp connection and owner's account phone.
PACKAGING_OWNER_WHATSAPP_TEMPLATE=
PACKAGING_OWNER_WHATSAPP_LANGUAGE=fr

# Delete account (30-day grace): invoke POST /internal/accounts/run daily to
# permanently delete accounts whose grace period has ended.
ACCOUNTS_SCHEDULER_ENABLED=false
ACCOUNTS_SCHEDULER_SECRET=

# Plans & billing: web page where merchants pay (app opens it in a browser).
# Leave empty until the payment page exists; subscriptions are activated
# manually by a Zomaal admin until a payment gateway is integrated.
BILLING_CHECKOUT_URL=

# Phone push via Firebase Cloud Messaging (HTTP v1). Auth uses Application
# Default Credentials — the Cloud Run service account needs the
# "Firebase Cloud Messaging API Admin" role on this project.
PUSH_NOTIFICATIONS_ENABLED=false
FCM_PROJECT_ID=

# QuickLivraison signs the raw body with the secret generated in its Webhooks dashboard.
# Production: stored in Secret Manager, never commit the actual value.
QUICKLIVRAISON_WEBHOOK_SECRET=
