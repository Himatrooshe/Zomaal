##########################################
# Application
##########################################

NODE_ENV=production

# Cloud Run provides PORT automatically
SWAGGER_ENABLED=false
WEBHOOK_DEBUG_ENABLED=false

# Update when frontend is deployed
CORS_ORIGINS=http://localhost:8081

##########################################
# Database
##########################################

DATABASE_URL=postgresql://zomaal:YOUR_URL_ENCODED_PASSWORD@localhost/zomaal?host=/cloudsql/zomaal:us-central1:zomaal-db&schema=public

##########################################
# Authentication
##########################################

JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET

##########################################
# Development
##########################################

DEV_OTP_ENABLED=false
DEV_OTP_CODE=

##########################################
# Redis
##########################################

REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=

##########################################
# Twilio
##########################################

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=

##########################################
# Sendit.ma
##########################################

SENDIT_API_BASE_URL=https://app.sendit.ma/api/v1
SENDIT_PUBLIC_KEY=
SENDIT_SECRET_KEY=
SENDIT_TOKEN_TTL_SECONDS=3300

SHIPPING_CREDENTIAL_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY

##########################################
# QuickLivraison
##########################################

QUICKLIVRAISON_API_BASE_URL=https://clients.quicklivraison.ma/api
QUICKLIVRAISON_API_KEY=
QUICKLIVRAISON_WEBHOOK_SECRET=

##########################################
# ForceLog
##########################################

FORCELOG_API_BASE_URL=https://api.forcelog.ma/customer
FORCELOG_HEALTH_BASE_URL=https://api.forcelog.ma
FORCELOG_API_KEY=

##########################################
# Ozone Express
##########################################

OZONEEXPRESS_API_BASE_URL=https://api.ozonexpress.ma
OZONEEXPRESS_CLIENT_BASE_URL=https://client.ozoneexpress.ma
OZONEEXPRESS_CUSTOMER_ID=
OZONEEXPRESS_API_KEY=

##########################################
# Shopify
##########################################

SHOPIFY_ENABLED=true

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

SHOPIFY_APP_URL=https://zomaal-backend-828793303867.us-central1.run.app

SHOPIFY_SCOPES=read_products,read_orders,read_customers

SHOPIFY_REDIRECT_URI=https://zomaal-backend-828793303867.us-central1.run.app/auth/shopify/callback

SHOPIFY_API_VERSION=2026-07

SHOPIFY_OAUTH_STATE_TTL_SECONDS=600
SHOPIFY_TOKEN_REFRESH_SKEW_SECONDS=300
SHOPIFY_HTTP_TIMEOUT_MS=15000

SHOPIFY_TOKEN_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY

##########################################
# Logger
##########################################

LOGGER_PHONE=
LOGGER_PASSWORD=

##########################################
# YouCan
##########################################

YOUCAN_ENABLED=true

YOUCAN_CLIENT_ID=2942
YOUCAN_CLIENT_SECRET=

YOUCAN_APP_URL=https://zomaal-backend-828793303867.us-central1.run.app

YOUCAN_REDIRECT_URI=https://zomaal-backend-828793303867.us-central1.run.app/auth/youcan/callback

YOUCAN_TOKEN_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY

YOUCAN_SCOPES=*

YOUCAN_OAUTH_STATE_TTL_SECONDS=600
YOUCAN_TOKEN_REFRESH_SKEW_SECONDS=300
YOUCAN_HTTP_TIMEOUT_MS=15000

##########################################
# Lightfunnels
##########################################

LIGHTFUNNELS_ENABLED=true

LIGHTFUNNELS_CLIENT_ID=
LIGHTFUNNELS_CLIENT_SECRET=

LIGHTFUNNELS_APP_URL=https://zomaal-backend-828793303867.us-central1.run.app

LIGHTFUNNELS_REDIRECT_URI=https://zomaal-backend-828793303867.us-central1.run.app/auth/lightfunnels/callback

LIGHTFUNNELS_TOKEN_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY

LIGHTFUNNELS_OAUTH_STATE_TTL_SECONDS=600
LIGHTFUNNELS_HTTP_TIMEOUT_MS=15000
LIGHTFUNNELS_SCOPES=orders,funnels

##########################################
# Facebook Ads
##########################################

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://zomaal-backend-828793303867.us-central1.run.app/auth/facebook/callback

##########################################
# Frontend Redirects
##########################################

# Change these after the frontend is deployed
SHOPIFY_AUTH_SUCCESS_REDIRECT_URL=http://localhost:8081/settings/integrations/shopify
SHOPIFY_AUTH_FAILURE_REDIRECT_URL=http://localhost:8081/settings/integrations/shopify