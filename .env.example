NODE_ENV=development
PORT=3000
SWAGGER_ENABLED=true
# Comma-separated browser origins. For temporary browser testing only, `*`
# enables all origins and automatically disables credentialed CORS requests.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
WEBHOOK_DEBUG_ENABLED=false

DATABASE_URL="postgresql://postgres:password@localhost:5434/zomaal"
DATABASE_CONNECTION_TIMEOUT_MS=10000

JWT_SECRET=replace-with-a-random-64-character-jwt-secret
LOGGER_PHONE=+212600000001
LOGGER_PASSWORD=replace-with-a-strong-password

# Local development only. Never enable in production.
DEV_OTP_ENABLED=true
DEV_OTP_CODE=123456

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_MS=5000

# Twilio
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_SERVICE_SID=replace-with-twilio-service-sid

# Sendit.ma
SENDIT_API_BASE_URL=https://app.sendit.ma/api/v1
SENDIT_TOKEN_TTL_SECONDS=3300
# Generate with: openssl rand -base64 32
SHIPPING_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# QuickLivraison
QUICKLIVRAISON_API_BASE_URL=https://clients.quicklivraison.ma/api
# API keys are supplied by users and stored encrypted in the database.
QUICKLIVRAISON_WEBHOOK_SECRET=replace-with-quicklivraison-webhook-secret

# ForceLog.ma
FORCELOG_API_BASE_URL=https://api.forcelog.ma/customer
# API keys are supplied by users and stored encrypted in the database.

# OzoneExpress.ma
OZONEEXPRESS_API_BASE_URL=https://api.ozonexpress.ma
OZONEEXPRESS_CLIENT_BASE_URL=https://client.ozoneexpress.ma
# Customer IDs and API keys are supplied by users and stored encrypted.


# Shopify
# When `shopify app dev` is running, it supplies SHOPIFY_API_KEY,
# SHOPIFY_API_SECRET, APP_URL/HOST, PORT, and SCOPES to the web process.
SHOPIFY_ENABLED=true
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Informational runtime copy only. `shopify.app.toml` is the source of truth.
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_customers
# Leave these empty with `shopify app dev`; APP_URL is supplied by the CLI.
SHOPIFY_APP_URL=
SHOPIFY_REDIRECT_URI=
SHOPIFY_API_VERSION=2026-07
# Generate with: openssl rand -base64 32
SHOPIFY_TOKEN_ENCRYPTION_KEY=
SHOPIFY_OAUTH_STATE_TTL_SECONDS=600
SHOPIFY_TOKEN_REFRESH_SKEW_SECONDS=300
SHOPIFY_HTTP_TIMEOUT_MS=15000
# The API returns JSON after OAuth when these are empty.
SHOPIFY_AUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/settings/integrations/shopify
SHOPIFY_AUTH_FAILURE_REDIRECT_URL=http://localhost:5173/settings/integrations/shopify

# YouCan
# Use the credentials from the YouCan Partner Dashboard. Keep Embedded=false.
YOUCAN_ENABLED=true
YOUCAN_CLIENT_ID=
YOUCAN_CLIENT_SECRET=
# Legacy CLIENT_ID/CLIENT_SECRET values are accepted during migration, but
# namespaced variables are preferred to avoid OAuth-provider collisions.
# Must exactly match the redirect URI configured for the YouCan app.
YOUCAN_APP_URL=http://localhost:3000
YOUCAN_REDIRECT_URI=http://localhost:3000/auth/youcan/callback
# Required for account verification and revenue synchronization.
# The current YouCan authorization server accepts one OAuth scope parameter.
YOUCAN_SCOPES=*
# Generate with: openssl rand -base64 32
YOUCAN_TOKEN_ENCRYPTION_KEY=
YOUCAN_OAUTH_STATE_TTL_SECONDS=600
YOUCAN_TOKEN_REFRESH_SKEW_SECONDS=300
YOUCAN_HTTP_TIMEOUT_MS=15000
# The API returns JSON after OAuth when these are empty.
YOUCAN_AUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/settings/integrations/youcan
YOUCAN_AUTH_FAILURE_REDIRECT_URL=http://localhost:5173/settings/integrations/youcan

# Lightfunnels
# Use credentials from the Lightfunnels Partners application configuration.
LIGHTFUNNELS_ENABLED=true
LIGHTFUNNELS_CLIENT_ID=
LIGHTFUNNELS_CLIENT_SECRET=
# Must exactly match the redirect URI whitelisted in Lightfunnels.
LIGHTFUNNELS_APP_URL=http://localhost:3000
LIGHTFUNNELS_REDIRECT_URI=http://localhost:3000/auth/lightfunnels/callback
# orders reads revenue; funnels allows account/store identity verification.
LIGHTFUNNELS_SCOPES=orders,funnels
# Generate with: openssl rand -base64 32
LIGHTFUNNELS_TOKEN_ENCRYPTION_KEY=
LIGHTFUNNELS_OAUTH_STATE_TTL_SECONDS=600
LIGHTFUNNELS_HTTP_TIMEOUT_MS=15000
# The API returns JSON after OAuth when these are empty.
LIGHTFUNNELS_AUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/settings/integrations/lightfunnels
LIGHTFUNNELS_AUTH_FAILURE_REDIRECT_URL=http://localhost:5173/settings/integrations/lightfunnels




SHOPIFY_AUTH_SUCCESS_REDIRECT_URL=https://your-mobile-domain.com/settings/integrations/shopify
SHOPIFY_AUTH_FAILURE_REDIRECT_URL=https://your-mobile-domain.com/settings/integrations/shopify

YOUCAN_AUTH_SUCCESS_REDIRECT_URL=https://your-mobile-domain.com/settings/integrations/youcan
YOUCAN_AUTH_FAILURE_REDIRECT_URL=https://your-mobile-domain.com/settings/integrations/youcan

LIGHTFUNNELS_AUTH_SUCCESS_REDIRECT_URL=https://your-mobile-domain.com/settings/integrations/lightfunnels
LIGHTFUNNELS_AUTH_FAILURE_REDIRECT_URL=https://your-mobile-domain.com/settings/integrations/lightfunnels
